{
  "name": "gerrymoeis-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:dev": "cross-env NODE_ENV=development DEPLOYMENT_ENVIRONMENT=development astro build",
    "build:staging": "cross-env NODE_ENV=production DEPLOYMENT_ENVIRONMENT=staging astro build",
    "build:prod": "cross-env NODE_ENV=production DEPLOYMENT_ENVIRONMENT=production astro build",
    "generate:cv": "node scripts/generate-cv.mjs",
    "generate:tech-icons": "node scripts/generate-tech-icons.mjs",
    "predeploy": "node scripts/generate-tech-icons.mjs && node scripts/optimize-images.mjs && node scripts/generate-cv.mjs",
    "build:local": "npm run generate:tech-icons && npm run optimize-images && npm run generate:cv && astro build",
    "optimize-images": "node scripts/optimize-images.mjs",
    "deploy": "node scripts/deploy.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "analyze": "npm run build:local && node scripts/analyze-bundles.js",
    "analyze:bundles": "node scripts/analyze-bundles.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.16.10",
    "glob": "^13.0.6",
    "gsap": "^3.14.2",
    "js-yaml": "^4.1.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.18.0",
    "tech-stack-icons": "^3.7.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "vitest": "^4.0.17"
  }
}
