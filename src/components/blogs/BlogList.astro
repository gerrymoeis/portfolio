---
/**
 * BlogList - Query and display all blog posts
 * Fetches all blog posts from the content collection and displays them as cards
 * Sorted by date (newest first)
 */

import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { getReadingTimeFromMarkdown } from '../../utils/readingTime';

// Query all blog posts from the content collection
const allBlogs = await getCollection('blogs');

// Sort blogs by date (newest first) and calculate reading time
const sortedBlogs = allBlogs
  .map((blog) => ({
    ...blog,
    readingTime: getReadingTimeFromMarkdown(blog.body),
  }))
  .sort((a, b) => {
    return b.data.date.getTime() - a.data.date.getTime();
  });
---

<section class="blog-list" aria-label="Blog posts">
  {sortedBlogs.length === 0 ? (
    <div class="blog-list__empty">
      <svg class="blog-list__empty-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"><path d="M509.5 84.2L427.8 2.5c-3.3-3.3-7.8-2.5-10.2 1.3l-34.5 51.7 73.4 73.4 51.7-34.5c3.9-2.4 4.7-6.9 1.3-10.2zM199.6 345.3l102.1-102.1L177.9 119.4l-102.1 102.1 123.8 123.8zm52.6-243.9l90.4-90.4 73.4 73.4-90.4 90.4-73.4-73.4zm-15.7 206.7l-38.1-38.1 29.8-29.8 38.1 38.1-29.8 29.8zm-43.5 43.5l-38.1-38.1 29.8-29.8 38.1 38.1-29.8 29.8zm-43.5 43.5l-38.1-38.1 29.8-29.8 38.1 38.1-29.8 29.8zM2.5 462.5c-3.3 3.3-2.4 7.8 1.3 10.2l35.6 23.7 86.3-86.3-38.1-38.1-85.1 90.5zM175 408.8l-38.1-38.1 29.8-29.8 38.1 38.1L175 408.8z"/></svg>
      <p class="blog-list__empty-text" data-bilingual>
        <span data-lang="en">No blog posts yet. Check back soon!</span>
        <span data-lang="id">Belum ada artikel blog. Nantikan segera!</span>
      </p>
    </div>
  ) : (
    <div class="blog-list__grid" role="list">
      {sortedBlogs.map((blog) => (
        <BlogCard
          title={blog.data.title}
          date={blog.data.date}
          summary={blog.data.summary}
          slug={blog.slug}
          tags={blog.data.tags}
          readingTime={blog.readingTime}
          thumbnail={blog.data.thumbnail}
        />
      ))}
    </div>
  )}
</section>

<style>
  .blog-list {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .blog-list__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .blog-list__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-16) var(--space-6);
  }
  
  .blog-list__empty-icon {
    font-size: var(--text-5xl);
    color: var(--color-text-tertiary);
    opacity: 0.5;
  }
  
  .blog-list__empty-text {
    font-family: var(--font-primary);
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
    text-align: center;
    margin: 0;
  }
  


  /* Desktop - 2 columns */
  @media (min-width: 900px) {
    .blog-list__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }
  
  /* Mobile */
  @media (max-width: 899px) {
    .blog-list {
      padding: 0;
    }

    .blog-list__grid {
      gap: var(--space-6);
    }
  }

  @media (max-width: var(--breakpoint-sm)) {
    .blog-list {
      padding: 0;
    }

    .blog-list__grid {
      gap: var(--space-5);
    }
    
    .blog-list__empty {
      padding: var(--space-12) var(--space-4);
    }
    
    .blog-list__empty-icon {
      font-size: var(--text-4xl);
    }

    .blog-list__empty-text {
      font-size: var(--text-base);
    }
  }
</style>
