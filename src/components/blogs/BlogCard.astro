---
/**
 * BlogCard - Individual blog preview card
 * Displays blog post metadata and summary with a link to the full post
 * 
 * Props:
 * - title: Blog post title (bilingual object)
 * - date: Publication date
 * - summary: Brief description (bilingual object)
 * - slug: URL slug for the blog post
 * - tags: Optional array of tags
 * - readingTime: Reading time in minutes
 */

import ViewCounter from './ViewCounter.astro';

interface Props {
  title: { en: string; id: string };
  date: Date;
  summary: { en: string; id: string };
  slug: string;
  tags?: string[];
  readingTime?: number;
}

const { title, date, summary, slug, tags, readingTime } = Astro.props;

// Format date for display (simple approach for build compatibility)
const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                'July', 'August', 'September', 'October', 'November', 'December'];
const formattedDate = `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
---

<article class="blog-card" role="listitem">
  <a href={`/blogs/${slug}`} class="blog-card__link" aria-label={`Read article: ${title.en}`}>
    <div class="blog-card__header">
      <h2 class="blog-card__title" data-bilingual>
        <span data-lang="en">{title.en}</span>
        <span data-lang="id">{title.id}</span>
      </h2>
      <div class="blog-card__meta">
        <time class="blog-card__date" datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {readingTime && (
          <span class="blog-card__reading-time" data-bilingual>
            <i class="fas fa-clock"></i>
            <span data-lang="en">{readingTime} min read</span>
            <span data-lang="id">{readingTime} menit baca</span>
          </span>
        )}
        <ViewCounter slug={slug} />
      </div>
    </div>
    
    <p class="blog-card__summary" data-bilingual>
      <span data-lang="en">{summary.en}</span>
      <span data-lang="id">{summary.id}</span>
    </p>
    
    {tags && tags.length > 0 && (
      <div class="blog-card__tags" role="list" aria-label="Article tags">
        {tags.map(tag => (
          <span class="blog-card__tag" role="listitem">{tag}</span>
        ))}
      </div>
    )}
  </a>
</article>

<style>
  .blog-card {
    background: var(--bg-elevated);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    box-shadow: 
      0 4px 12px var(--color-shadow-medium),
      0 2px 4px var(--color-shadow-light);
    transition: 
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  /* Subtle grain texture overlay */
  .blog-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/textures/grain.png');
    opacity: 0.03;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .blog-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }
  
  /* Dark theme hover - golden yellow glow */
  :global(html:not([data-theme="light"])) .blog-card {
    border-color: rgba(246, 224, 94, 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 2px 8px rgba(0, 0, 0, 0.3);
  }
  
  :global(html:not([data-theme="light"])) .blog-card:hover {
    border-color: rgba(246, 224, 94, 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(246, 224, 94, 0.3),
      0 0 15px rgba(246, 224, 94, 0.2);
  }
  
  /* Light theme hover - red-orange glow */
  :global([data-theme="light"]) .blog-card {
    border-color: rgba(255, 85, 0, 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  :global([data-theme="light"]) .blog-card:hover {
    border-color: rgba(255, 85, 0, 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 85, 0, 0.25),
      0 0 15px rgba(255, 85, 0, 0.15);
  }

  .blog-card__link {
    display: block;
    padding: var(--space-6);
    color: inherit;
    text-decoration: none;
    position: relative;
    z-index: 1;
  }

  .blog-card__link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }

  .blog-card__header {
    margin-bottom: var(--space-4);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .blog-card__title {
    font-family: var(--font-primary);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
    transition: color var(--duration-fast) var(--ease-out);
  }
  
  /* Hide inactive language */
  .blog-card__title span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .blog-card__title span[data-lang="en"],
  :global(html[lang="id"]) .blog-card__title span[data-lang="id"] {
    display: inline;
  }

  .blog-card:hover .blog-card__title {
    color: var(--color-accent-primary);
  }

  .blog-card__date {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-text-tertiary);
  }
  
  .blog-card__reading-time {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-text-tertiary);
  }
  
  .blog-card__reading-time i {
    font-size: var(--text-xs);
    opacity: 0.7;
  }
  
  /* Hide inactive language */
  .blog-card__reading-time span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .blog-card__reading-time span[data-lang="en"],
  :global(html[lang="id"]) .blog-card__reading-time span[data-lang="id"] {
    display: inline;
  }

  .blog-card__summary {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  
  /* Hide inactive language */
  .blog-card__summary span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .blog-card__summary span[data-lang="en"],
  :global(html[lang="id"]) .blog-card__summary span[data-lang="id"] {
    display: inline;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-card__tag {
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background-color: var(--color-social-hover-bg-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-medium);
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }

    .blog-card:hover {
      transform: none;
    }

    .blog-card__title {
      transition: none;
    }
  }
</style>
