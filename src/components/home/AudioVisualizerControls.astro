---
/**
 * AudioVisualizerControls - UX-friendly visualizer controls
 * Features: 
 * - First-time landing overlay
 * - Concise permission modal
 * - Start button (bottom right)
 * - Toast notifications (top right)
 */

import ActionButton from '../ui/ActionButton.astro';

export interface Props {
  /** Additional CSS class names */
  className?: string;
}

const { className = '' } = Astro.props;

const playIconSvg = '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 2l11 7-11 7V2z" fill="currentColor"/></svg>';
---

<!-- First-Time Landing Overlay -->
<div class="visualizer-landing" id="visualizerLanding" style="display: none;">
  <div class="visualizer-landing__backdrop"></div>
  <div class="visualizer-landing__content">
    <div class="visualizer-landing__left">
      <h2 class="visualizer-landing__title" data-bilingual="visualizer-title">
        <span data-lang="en">Enhanced Audio Experience</span>
        <span data-lang="id">Pengalaman Audio yang Ditingkatkan</span>
      </h2>
      <p class="visualizer-landing__description" data-bilingual="visualizer-description">
        <span data-lang="en">
          This site features a <span class="visualizer-landing__highlight">real-time music visualizer</span> that syncs with <span class="visualizer-landing__highlight">audio playback</span>. 
          On desktop, we'll need permission to listen to this tab's audio. On mobile, we'll use your microphone to visualize ambient sound.
        </span>
        <span data-lang="id">
          Situs ini memiliki <span class="visualizer-landing__highlight">visualizer musik real-time</span> yang sinkron dengan <span class="visualizer-landing__highlight">pemutaran audio</span>. 
          Di desktop, kami memerlukan izin untuk mendengarkan audio tab ini. Di mobile, kami akan menggunakan mikrofon Anda untuk memvisualisasikan suara sekitar.
        </span>
      </p>
      <p class="visualizer-landing__privacy" data-bilingual="visualizer-privacy">
        <span data-lang="en">
          <span class="visualizer-landing__privacy-highlight">No recording</span> or <span class="visualizer-landing__privacy-highlight">data collection</span>. Audio is analyzed in real-time only.
        </span>
        <span data-lang="id">
          <span class="visualizer-landing__privacy-highlight">Tidak ada rekaman</span> atau <span class="visualizer-landing__privacy-highlight">pengumpulan data</span>. Audio hanya dianalisis secara real-time.
        </span>
      </p>
    </div>
    <div class="visualizer-landing__right">
      <button class="visualizer-landing__button visualizer-landing__button--secondary" id="landingSkip" data-bilingual="skip-button">
        <span data-lang="en">Skip for Now</span>
        <span data-lang="id">Lewati Sekarang</span>
      </button>
      <button class="visualizer-landing__button visualizer-landing__button--primary" id="landingEnable" data-bilingual="enable-button">
        <span data-lang="en">Enable Visualizer</span>
        <span data-lang="id">Aktifkan Visualizer</span>
      </button>
    </div>
  </div>
</div>

<!-- Start Visualizer Button (bottom right, shown when stopped) -->
<ActionButton
  id="visualizerStartBtn"
  iconSvg={playIconSvg}
  labelEn="Start Visualizer"
  labelId="Mulai Visualizer"
  variant="fixed"
  className="visualizer-start-btn"
  ariaLabel="Start audio visualizer"
/>

<style is:inline>
  #visualizerStartBtn {
    display: none;
  }
</style>

<!-- Toast Notification (top right) -->
<div class={`visualizer-toast ${className}`} id="visualizerToast" data-visualizer-toast style="display: none;">
  <div class="visualizer-toast__content">
    <span class="visualizer-toast__text" id="toastText">Waiting for music...</span>
    <button class="visualizer-toast__close" id="toastClose" aria-label="Close notification">
      <svg width="24" height="24" viewBox="0 0 16 16" fill="none">
        <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <div class="visualizer-toast__progress" id="toastProgress"></div>
</div>

<script>
  import { getTabAudioVisualizer } from '../../scripts/tabAudioVisualizer';
  import { ToastManager } from '../../scripts/visualizer/toastManager';
  import { LandingManager } from '../../scripts/visualizer/landingManager';
  import { getMessage } from '../../scripts/visualizer/messages';

  class StartButtonManager {
    private button: HTMLElement;
    private onClick: (() => void) | null = null;

    constructor() {
      this.button = document.getElementById('visualizerStartBtn') as HTMLElement;
      this.button.addEventListener('click', () => this.onClick?.());
    }

    public show(onClick: () => void): void {
      this.onClick = onClick;
      this.button.style.display = 'flex';
    }

    public hide(): void {
      this.button.style.display = 'none';
    }
  }

  const MSG_MAP: [string, Parameters<typeof getMessage>[0]][] = [
    ['already running', 'alreadyRunning'],
    ['Requesting tab audio capture', 'requesting'],
    ['Requesting microphone access', 'requestingMic'],
    ['Audio captured', 'audioCaptured'],
    ['Microphone access granted', 'micGranted'],
    ['Visualizing!', 'visualizing'],
    ['Screen sharing stopped', 'screenSharingStopped'],
    ['Microphone access stopped', 'micStopped'],
    ['Waiting for music', 'waiting'],
    ['stopped', 'stopped'],
    ['Microphone permission denied', 'micPermissionDenied'],
    ['Permission denied', 'permissionDenied'],
    ['No audio track found', 'noAudioTrack'],
    ['No audio source', 'noAudioSource'],
    ['not supported', 'notSupported'],
    ['Failed to start visualizer', 'failed'],
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const toastManager = new ToastManager();
    const landingManager = new LandingManager();
    const startButtonManager = new StartButtonManager();
    const visualizer = getTabAudioVisualizer();

    visualizer.setStatusCallback((message: string, type: 'info' | 'success' | 'error') => {
      let translatedMessage = message;
      let messageKey: typeof MSG_MAP[0][1] | undefined;

      for (const [search, key] of MSG_MAP) {
        if (message.includes(search)) {
          messageKey = key;
          const errorPart = search === 'Failed to start visualizer'
            ? message.replace('Failed to start visualizer: ', '')
            : '';
          translatedMessage = errorPart ? getMessage(key) + errorPart : getMessage(key);
          break;
        }
      }

      const duration = type === 'error' ? 7000 : type === 'success' ? 4000 : 5000;
      toastManager.show(translatedMessage, type, duration, messageKey);

      if (message.includes('stopped') || message.includes('denied') || message.includes('Failed')) {
        startButtonManager.show(() => startVisualizer());
      }
    });

    async function startVisualizer(): Promise<void> {
      startButtonManager.hide();
      try {
        await visualizer.start();
      } catch {
        startButtonManager.show(() => startVisualizer());
      }
    }

    function checkFirstVisit(): void {
      if (!landingManager.hasBeenShown()) {
        setTimeout(() => {
          landingManager.show(() => startVisualizer(), () => startButtonManager.show(() => startVisualizer()));
        }, 1000);
      } else {
        startButtonManager.show(() => startVisualizer());
      }
    }

    if (document.readyState === 'complete') {
      checkFirstVisit();
    } else {
      window.addEventListener('load', () => checkFirstVisit());
    }
  });
</script>

<style>
  /* Landing Overlay Styles */
  .visualizer-landing {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .visualizer-landing--visible {
    opacity: 1;
  }

  .visualizer-landing__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(var(--blur-backdrop-medium));
    -webkit-backdrop-filter: blur(var(--blur-backdrop-medium));
  }
  
  /* Light theme backdrop - lighter overlay */
  :global([data-theme="light"]) .visualizer-landing__backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .visualizer-landing__content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    width: 100%;
    display: flex;
    gap: var(--space-6);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border: var(--panel-border-width) var(--panel-border-style) var(--color-border-accent);
    transform: scale(0.95);
    transition: transform var(--duration-medium) var(--ease-out);
  }
  
  /* Dark theme - solid background for better contrast */
  :global(html:not([data-theme="light"])) .visualizer-landing__content {
    background: rgba(30, 35, 42, 0.98);
  }
  
  /* Light theme - solid background for better contrast */
  :global([data-theme="light"]) .visualizer-landing__content {
    background: rgba(255, 255, 255, 0.98);
  }
  
  /* Dark theme - golden glow */
  :global(html:not([data-theme="light"])) .visualizer-landing__content {
    box-shadow: 
      var(--glow-strong) var(--color-shadow-accent),
      0 var(--space-5) var(--space-12) var(--color-shadow-strong);
  }
  
  /* Light theme - red-orange glow */
  :global([data-theme="light"]) .visualizer-landing__content {
    box-shadow: 
      var(--glow-strong) var(--color-shadow-accent),
      0 var(--space-5) var(--space-12) var(--color-shadow-medium);
  }

  .visualizer-landing--visible .visualizer-landing__content {
    transform: scale(1);
  }

  .visualizer-landing__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .visualizer-landing__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }
  


  .visualizer-landing__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }
  


  .visualizer-landing__highlight {
    color: var(--color-accent-primary);
    font-weight: 700;
  }
  
  /* Dark theme - add glow effect */
  :global(html:not([data-theme="light"])) .visualizer-landing__highlight {
    text-shadow: var(--glow-subtle) var(--color-shadow-accent);
  }
  
  /* Light theme - no glow */
  :global([data-theme="light"]) .visualizer-landing__highlight {
    text-shadow: none;
  }

  .visualizer-landing__privacy {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    line-height: 1.5;
    margin: 0;
    padding-top: var(--space-2);
    border-top: var(--panel-border-width) var(--panel-border-style) var(--color-border-light);
  }
  


  .visualizer-landing__privacy-highlight {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .visualizer-landing__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
    min-width: 160px;
  }

  .visualizer-landing__button {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-base);
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 2px solid transparent;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }
  


  /* Dark theme secondary button - improved contrast */
  :global(html:not([data-theme="light"])) .visualizer-landing__button--secondary {
    background: transparent;
    color: var(--color-text-primary);
    border: 2px solid rgba(var(--accent-rgb), 0.5);
  }
  
  :global(html:not([data-theme="light"])) .visualizer-landing__button--secondary:hover {
    background: rgba(var(--accent-rgb), 0.1);
    border-color: rgba(var(--accent-rgb), 0.8);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.4),
      inset 0 0 10px rgba(var(--accent-rgb), 0.08);
    transform: var(--transform-hover-lift);
  }
  
  /* Light theme secondary button - improved contrast */
  :global([data-theme="light"]) .visualizer-landing__button--secondary {
    background: rgba(var(--accent-rgb), 0.12);
    color: #1a1a1a;
    border: 2px solid rgba(var(--accent-rgb), 0.6);
  }
  
  :global([data-theme="light"]) .visualizer-landing__button--secondary:hover {
    background: rgba(var(--accent-rgb), 0.2);
    border-color: rgba(var(--accent-rgb), 0.9);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.4),
      inset 0 0 10px rgba(var(--accent-rgb), 0.08);
    transform: var(--transform-hover-lift);
  }

  .visualizer-landing__button--primary {
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
    font-weight: 600;
  }
  
  /* Dark theme primary button - improved text contrast */
  :global(html:not([data-theme="light"])) .visualizer-landing__button--primary {
    background: var(--color-accent-primary);
    color: #1e232a;
    box-shadow: var(--glow-medium) var(--color-shadow-accent);
  }

  :global(html:not([data-theme="light"])) .visualizer-landing__button--primary:hover {
    background: var(--color-bg-dark);
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    box-shadow: 
      0 0 40px rgba(var(--accent-rgb), 0.8),
      0 0 20px rgba(var(--accent-rgb), 0.6),
      inset 0 0 20px rgba(var(--accent-rgb), 0.1);
    text-shadow: 0 0 10px rgba(var(--accent-rgb), 0.8);
    transform: var(--transform-hover-lift-strong);
  }
  
  /* Light theme primary button */
  :global([data-theme="light"]) .visualizer-landing__button--primary {
    background: var(--color-accent-primary);
    color: #ffffff;
    box-shadow: var(--glow-medium) var(--color-shadow-accent);
  }
  
  :global([data-theme="light"]) .visualizer-landing__button--primary:hover {
    background: #ffffff;
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    box-shadow: 
      0 0 40px rgba(var(--accent-rgb), 0.8),
      0 0 20px rgba(var(--accent-rgb), 0.6),
      inset 0 0 20px rgba(var(--accent-rgb), 0.1);
    text-shadow: 0 0 10px rgba(var(--accent-rgb), 0.8);
    transform: var(--transform-hover-lift-strong);
  }

  .visualizer-landing__button--primary:active {
    transform: translateY(0);
  }

  /* Toast Styles (Top Right) */
  .visualizer-toast {
    position: fixed;
    top: 120px; /* Desktop: below navbar, adjusted to not cover navbar */
    right: var(--space-6);
    z-index: 1000;
    min-width: 300px;
    max-width: 400px;
    background: var(--bg-surface);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: var(--radius-md);
    overflow: hidden;
    opacity: 0;
    transform: translateY(-20px);
    transition: all 0.3s var(--ease-out);
    pointer-events: none;
  }
  
  /* Dark theme toast - solid background with blur */
  :global(html:not([data-theme="light"])) .visualizer-toast {
    background: rgba(54, 61, 71, 0.95);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.3),
      0 8px 24px rgba(0, 0, 0, 0.4);
  }
  
  /* Light theme toast - solid background with blur */
  :global([data-theme="light"]) .visualizer-toast {
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.4),
      0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .visualizer-toast--visible {
    opacity: 1; /* Full opacity - no transparency */
    transform: translateY(0);
    pointer-events: auto;
  }

  .visualizer-toast__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .visualizer-toast__text {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .visualizer-toast__close {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .visualizer-toast__close:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-border-accent);
  }
  
  /* Toast close button hover */
  .visualizer-toast__close:hover {
    background: rgba(var(--accent-rgb), 0.1);
    border-color: rgba(var(--accent-rgb), 0.6);
  }

  .visualizer-toast__close:active {
    transform: scale(0.95);
  }

  .visualizer-toast__progress {
    height: 3px;
    width: 100%;
    background: var(--color-accent-primary);
    transform-origin: left;
    transition: width 0.1s linear;
  }

  .visualizer-toast--info {
    border-left: 4px solid var(--color-accent-primary);
  }

  .visualizer-toast--info .visualizer-toast__text {
    color: var(--color-text-primary); /* Keep default text color for info */
  }

  .visualizer-toast--info .visualizer-toast__progress {
    background: var(--color-accent-primary);
  }

  .visualizer-toast--success {
    border-left: 4px solid var(--toast-success-border);
  }

  .visualizer-toast--success .visualizer-toast__text {
    color: var(--toast-success-text);
  }

  .visualizer-toast--success .visualizer-toast__progress {
    background: var(--toast-success-progress);
  }

  .visualizer-toast--error {
    border-left: 4px solid var(--toast-error-border);
  }

  .visualizer-toast--error .visualizer-toast__text {
    color: var(--toast-error-text);
  }

  .visualizer-toast--error .visualizer-toast__progress {
    background: var(--toast-error-progress);
  }

  /* Responsive - Mobile and Tablet */
  @media (max-width: var(--breakpoint-lg)) {
    .visualizer-landing__content {
      flex-direction: column;
      max-width: 90vw;
      gap: var(--space-6);
      padding: var(--space-6);
    }

    .visualizer-landing__left {
      width: 100%;
    }

    .visualizer-landing__right {
      width: 100%;
      min-width: auto;
      flex-direction: column; /* Stack buttons vertically */
      gap: var(--space-4);
    }
    
    .visualizer-landing__button {
      width: 100%;
      justify-content: center;
      padding: var(--space-4) var(--space-5);
    }

    .visualizer-landing__title {
      font-size: var(--text-xl);
    }
    
    .visualizer-landing__description {
      font-size: var(--text-sm);
    }
    
    .visualizer-landing__privacy {
      font-size: var(--text-xs);
    }

    .visualizer-toast {
      top: var(--space-6); /* Mobile: top right, replacing hamburger menu position */
      right: var(--space-4);
      left: var(--space-4);
      min-width: auto;
      max-width: none;
    }

    .visualizer-toast__content {
      padding: var(--space-2) var(--space-3);
    }

    .visualizer-toast__text {
      font-size: var(--text-xs);
    }
  }

</style>
