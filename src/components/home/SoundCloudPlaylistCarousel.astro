---
/**
 * SoundCloudPlaylistCarousel - Carousel for SoundCloud playlist embeds
 * Optimized with lazy loading using Intersection Observer
 * Single iframe per playlist using universal amber color (#ffa600)
 */

import NavigationControls from './NavigationControls.astro';
import PaginationIndicator from './PaginationIndicator.astro';

export interface SoundCloudPlaylist {
  id: string;
  title: string;
  embedUrl: string;
  artist: string;
}

export interface Props {
  /** SoundCloud playlists to display */
  playlists?: SoundCloudPlaylist[];
  /** Show navigation controls */
  showControls?: boolean;
  /** Additional CSS class names */
  className?: string;
  /** Enable lazy loading (default: true) */
  lazyLoad?: boolean;
}

const { 
  playlists = [],
  showControls = true,
  className = '',
  lazyLoad = true
} = Astro.props;

// Determine if we should show carousel controls
const isMultiplePlaylist = playlists.length > 1;
const shouldShowControls = isMultiplePlaylist && showControls;

// Generate unique IDs for accessibility
const carouselId = `soundcloud-carousel-${Math.random().toString(36).substring(2, 9)}`;
const liveRegionId = `${carouselId}-live-region`;
---

{playlists.length > 0 && (
  <div 
    class={`soundcloud-playlist-carousel ${className}`}
    role="region"
    aria-label="SoundCloud playlist carousel"
    aria-describedby={liveRegionId}
    data-carousel-id={carouselId}
    data-total-playlists={playlists.length}
    data-show-controls={shouldShowControls}
    data-playlists={JSON.stringify(playlists)}
    data-lazy-load={lazyLoad}
  >
    <!-- Accessibility: Live region for screen reader announcements -->
    <div 
      id={liveRegionId}
      class="carousel-live-region"
      aria-live="polite"
      aria-atomic="true"
    >
      Showing playlist 1 of {playlists.length}: {playlists[0]?.title}
    </div>

    <!-- Carousel container -->
    <div class="carousel-embed-container">
      <!-- Theme overlay for SoundCloud iframe -->
      <div class="carousel-theme-overlay"></div>
      
      {playlists.map((playlist, index) => (
        <div 
          class={`carousel-embed ${index === 0 ? 'active' : ''}`}
          data-index={index}
          data-embed-url={playlist.embedUrl}
          data-embed-title={playlist.title}
          data-loaded={!lazyLoad && index === 0 ? 'true' : 'false'}
          style={index === 0 ? '' : 'display: none;'}
        >
          {lazyLoad ? (
            <!-- Lazy load placeholder -->
            <div class="soundcloud-placeholder" data-playlist-index={index}>
              <div class="placeholder-content">
                <svg class="placeholder-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z" fill="currentColor"/>
                </svg>
                <p class="placeholder-text">Click to load {playlist.title}</p>
                <p class="placeholder-artist">{playlist.artist}</p>
              </div>
            </div>
          ) : (
            <!-- Immediate load -->
            <iframe 
              class="soundcloud-iframe"
              width="100%" 
              height="450"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              sandbox="allow-forms allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts allow-presentation"
              src={playlist.embedUrl}
              title={playlist.title}
              loading={index === 0 ? 'eager' : 'lazy'}
              style="border: none;"
            ></iframe>
          )}
        </div>
      ))}
    </div>

    <!-- Navigation controls (only shown for multiple playlists) -->
    {shouldShowControls && (
      <NavigationControls 
        currentIndex={0}
        totalPlaylists={playlists.length}
        showControls={shouldShowControls}
        labels={{
          previous: "Previous playlist",
          next: "Next playlist"
        }}
      />
    )}

    <!-- Pagination indicators (only shown for multiple playlists) -->
    {shouldShowControls && (
      <PaginationIndicator 
        playlists={playlists}
        currentIndex={0}
        clickable={true}
        className="carousel-pagination-component"
        ariaLabel="Playlist navigation indicators"
      />
    )}
  </div>
)}

<style>
  .soundcloud-playlist-carousel {
    position: relative;
    width: 100%;
    max-width: 100%;
    isolation: isolate;
  }

  /* Accessibility: Hide live region visually but keep it available to screen readers */
  .carousel-live-region {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Embed container */
  .carousel-embed-container {
    width: 100%;
    height: 450px;
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }
  
  /* Theme overlay - transparent color tint over SoundCloud iframe */
  .carousel-theme-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; /* Allow clicks to pass through to iframe */
    z-index: 1;
    border-radius: 8px;
    transition: background-color 0.3s ease;
  }
  
  /* Dark theme - golden yellow tint */
  :global(html:not([data-theme="light"])) .carousel-theme-overlay {
    background-color: rgba(246, 224, 94, 0.15);
  }
  
  /* Light theme - red-orange tint */
  :global([data-theme="light"]) .carousel-theme-overlay {
    background-color: rgba(255, 85, 0, 0.08);
  }

  .carousel-embed {
    width: 100%;
    height: 100%;
    transition: opacity 0.3s ease;
    /* Ensure iframe doesn't shrink below minimum width on mobile */
    min-width: 100%;
  }

  .carousel-embed.active {
    display: block !important;
  }

  /* SoundCloud iframe styling */
  .soundcloud-iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 8px;
    overflow: hidden;
    /* Improve touch interaction on mobile */
    touch-action: manipulation;
    /* Ensure proper rendering on mobile */
    -webkit-overflow-scrolling: touch;
    /* Prevent iframe from shrinking below minimum width */
    min-width: 100%;
  }

  /* Pagination indicators styling */
  .carousel-pagination-component {
    margin-top: 2px;
  }

  /* Lazy load placeholder styling */
  .soundcloud-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border-radius: 8px;
    border: 2px dashed var(--color-border);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .soundcloud-placeholder:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-elevated);
  }

  .placeholder-content {
    text-align: center;
    padding: var(--space-6);
  }

  .placeholder-icon {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    opacity: 0.8;
  }

  .placeholder-text {
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .placeholder-artist {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  /* Loading state */
  .soundcloud-placeholder.loading {
    pointer-events: none;
  }

  .soundcloud-placeholder.loading .placeholder-icon {
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 0.3; }
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .carousel-embed-container {
      height: 400px;
      /* Show scrollbar hint on mobile */
      scrollbar-width: thin;
      scrollbar-color: rgba(246, 224, 94, 0.5) transparent;
    }
    
    /* Webkit scrollbar styling for mobile */
    .carousel-embed-container::-webkit-scrollbar {
      height: 8px;
    }
    
    .carousel-embed-container::-webkit-scrollbar-track {
      background: transparent;
    }
    
    .carousel-embed-container::-webkit-scrollbar-thumb {
      background: rgba(246, 224, 94, 0.5);
      border-radius: 4px;
    }
    
    .carousel-embed-container::-webkit-scrollbar-thumb:hover {
      background: rgba(246, 224, 94, 0.7);
    }
    
    .carousel-embed iframe {
      height: 400px;
    }
  }

  /* Reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .carousel-embed {
      transition: none;
    }
  }
</style>

<script>
  // SoundCloud carousel navigation with lazy loading
  class SoundCloudPlaylistCarousel {
    private container: HTMLElement;
    private liveRegion: HTMLElement;
    private currentIndex: number = 0;
    private totalPlaylists: number;
    private playlists: any[];
    private embeds: NodeListOf<HTMLElement>;
    private lazyLoad: boolean;
    private observer: IntersectionObserver | null = null;
    
    constructor(container: HTMLElement) {
      this.container = container;
      this.liveRegion = container.querySelector('.carousel-live-region') as HTMLElement;
      this.totalPlaylists = parseInt(container.dataset.totalPlaylists || '0', 10);
      this.playlists = JSON.parse(container.dataset.playlists || '[]');
      this.embeds = container.querySelectorAll('.carousel-embed');
      this.lazyLoad = container.dataset.lazyLoad === 'true';
      
      this.init();
    }
    
    private init() {
      if (this.lazyLoad) {
        this.setupLazyLoading();
      }
      
      if (this.totalPlaylists <= 1) return;
      
      this.setupEventListeners();
      this.updateAccessibility();
    }
    
    private setupLazyLoading() {
      // Setup Intersection Observer for lazy loading
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.loadVisibleEmbeds();
              // Disconnect after first load
              if (this.observer) {
                this.observer.disconnect();
              }
            }
          });
        },
        {
          rootMargin: '100px', // Load 100px before visible
          threshold: 0.1
        }
      );
      
      this.observer.observe(this.container);
      
      // Setup click handlers for placeholders
      const placeholders = this.container.querySelectorAll('.soundcloud-placeholder');
      placeholders.forEach((placeholder, index) => {
        placeholder.addEventListener('click', () => {
          this.loadEmbed(index);
        });
      });
    }
    
    private loadVisibleEmbeds() {
      // Load the first (active) embed
      this.loadEmbed(this.currentIndex);
    }
    
    private loadEmbed(index: number) {
      const embed = this.embeds[index];
      if (!embed) return;
      
      const isLoaded = embed.dataset.loaded === 'true';
      if (isLoaded) return;
      
      const placeholder = embed.querySelector('.soundcloud-placeholder');
      if (!placeholder) return;
      
      // Add loading state
      placeholder.classList.add('loading');
      
      // Get embed data
      const embedUrl = embed.dataset.embedUrl;
      const embedTitle = embed.dataset.embedTitle;
      
      if (!embedUrl) return;
      
      // Create iframe
      const iframe = document.createElement('iframe');
      iframe.className = 'soundcloud-iframe';
      iframe.width = '100%';
      iframe.height = '450';
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      iframe.sandbox.add('allow-forms', 'allow-popups', 'allow-popups-to-escape-sandbox', 'allow-same-origin', 'allow-scripts', 'allow-presentation');
      iframe.src = embedUrl;
      iframe.title = embedTitle || `SoundCloud playlist ${index + 1}`;
      iframe.style.border = 'none';
      
      // Replace placeholder with iframe
      placeholder.replaceWith(iframe);
      
      // Mark as loaded
      embed.dataset.loaded = 'true';
    }
    
    private setupEventListeners() {
      // Listen for navigation events from NavigationControls component
      this.container.addEventListener('carousel:navigate', this.handleNavigationEvent.bind(this) as EventListener);
      
      // Listen for pagination events from PaginationIndicator component
      this.container.addEventListener('pagination:navigate', this.handlePaginationEvent.bind(this) as EventListener);
      
      // Keyboard navigation for the carousel container
      this.container.addEventListener('keydown', this.handleKeyboard.bind(this));
    }
    
    private handleNavigationEvent(event: Event) {
      const customEvent = event as CustomEvent;
      const { direction } = customEvent.detail;
      
      if (direction === 'next' && this.currentIndex < this.totalPlaylists - 1) {
        this.navigateToIndex(this.currentIndex + 1);
      } else if (direction === 'previous' && this.currentIndex > 0) {
        this.navigateToIndex(this.currentIndex - 1);
      }
    }
    
    private handlePaginationEvent(event: Event) {
      const customEvent = event as CustomEvent;
      const { index } = customEvent.detail;
      
      this.navigateToIndex(index);
    }
    
    private handleKeyboard(event: KeyboardEvent) {
      if (event.target !== this.container && !this.container.contains(event.target as Node)) {
        return;
      }
      
      switch (event.key) {
        case 'ArrowLeft':
          event.preventDefault();
          if (this.currentIndex > 0) {
            this.navigateToIndex(this.currentIndex - 1);
          }
          break;
        case 'ArrowRight':
          event.preventDefault();
          if (this.currentIndex < this.totalPlaylists - 1) {
            this.navigateToIndex(this.currentIndex + 1);
          }
          break;
      }
    }
    
    private navigateToIndex(index: number) {
      if (index === this.currentIndex || index < 0 || index >= this.totalPlaylists) {
        return;
      }
      
      // Load embed if lazy loading is enabled
      if (this.lazyLoad) {
        this.loadEmbed(index);
      }
      
      // Hide current embed
      this.embeds[this.currentIndex]?.classList.remove('active');
      this.embeds[this.currentIndex]?.setAttribute('style', 'display: none;');
      
      // Show new embed
      this.currentIndex = index;
      this.embeds[this.currentIndex]?.classList.add('active');
      this.embeds[this.currentIndex]?.setAttribute('style', '');
      
      // Update UI
      this.updateNavigationState();
      this.updatePaginationState();
      this.updateAccessibility();
    }
    
    private updateNavigationState() {
      // Update NavigationControls component state
      const navigationControls = this.container.querySelector('.navigation-controls');
      if (navigationControls && (window as any).NavigationControlsHandler) {
        const handler = (navigationControls as any).navigationHandler;
        if (handler && handler.updateButtonStates) {
          handler.updateButtonStates(this.currentIndex, this.totalPlaylists);
        }
      }
    }
    
    private updatePaginationState() {
      // Update PaginationIndicator component state
      const paginationIndicator = this.container.querySelector('[data-pagination-indicator]');
      if (paginationIndicator && (paginationIndicator as any).paginationHandler) {
        const handler = (paginationIndicator as any).paginationHandler;
        handler.updateState(this.currentIndex);
      }
    }
    
    private updateAccessibility() {
      if (this.liveRegion) {
        const currentPlaylist = this.playlists[this.currentIndex];
        const playlistTitle = currentPlaylist?.title || `Playlist ${this.currentIndex + 1}`;
        
        this.liveRegion.textContent = `Showing playlist ${this.currentIndex + 1} of ${this.totalPlaylists}: ${playlistTitle}`;
      }
    }
  }
  
  // Initialize carousels when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.soundcloud-playlist-carousel');
    carousels.forEach(carousel => {
      new SoundCloudPlaylistCarousel(carousel as HTMLElement);
    });
  });
</script>
