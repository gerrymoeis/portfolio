---
/**
 * NavigationControls - Carousel navigation buttons component
 * Provides left/right navigation buttons with proper ARIA labels and keyboard support
 * Implements HD-2D design system styling with hover effects
 */

export interface Props {
  /** Current active playlist index */
  currentIndex: number;
  /** Total number of playlists */
  totalPlaylists: number;
  /** Whether to show navigation controls */
  showControls?: boolean;
  /** Additional CSS class names */
  className?: string;
  /** Custom labels for accessibility */
  labels?: {
    previous: string;
    next: string;
  };
}

const { 
  currentIndex = 0,
  totalPlaylists = 0,
  showControls = true,
  className = '',
  labels = {
    previous: 'Previous playlist',
    next: 'Next playlist'
  }
} = Astro.props;

// Calculate button states based on position
const canGoPrevious = currentIndex > 0;
const canGoNext = currentIndex < totalPlaylists - 1;

// Only render if we have multiple playlists and controls are enabled
const shouldRender = showControls && totalPlaylists > 1;
---

{shouldRender && (
  <div 
    class={`navigation-controls ${className}`}
    role="group" 
    aria-label="Playlist navigation controls"
  >
    <!-- Previous Button -->
    <button 
      class="nav-button nav-button--previous"
      aria-label={labels.previous}
      data-carousel-nav="previous"
      disabled={!canGoPrevious}
      type="button"
    >
      <svg 
        class="nav-button__icon" 
        width="24" 
        height="24" 
        viewBox="0 0 24 24" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path 
          d="M15 18L9 12L15 6" 
          stroke="currentColor" 
          stroke-width="2" 
          stroke-linecap="round" 
          stroke-linejoin="round"
        />
      </svg>
      <span class="nav-button__label">{labels.previous}</span>
    </button>
    
    <!-- Next Button -->
    <button 
      class="nav-button nav-button--next"
      aria-label={labels.next}
      data-carousel-nav="next"
      disabled={!canGoNext}
      type="button"
    >
      <svg 
        class="nav-button__icon" 
        width="24" 
        height="24" 
        viewBox="0 0 24 24" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path 
          d="M9 18L15 12L9 6" 
          stroke="currentColor" 
          stroke-width="2" 
          stroke-linecap="round" 
          stroke-linejoin="round"
        />
      </svg>
      <span class="nav-button__label">{labels.next}</span>
    </button>
  </div>
)}

<style>
  .navigation-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: absolute;
    top: 50%;
    left: var(--space-2); /* Reduced padding */
    right: var(--space-2); /* Reduced padding */
    transform: translateY(-50%);
    pointer-events: none;
    z-index: var(--layer-elevated);
    padding: 0;
  }

  .nav-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    cursor: pointer;
    pointer-events: auto;
    transition: 
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    
    /* Active state */
    &:active:not(:disabled) {
      transform: translateY(0);
    }
    
    /* Disabled state */
    &:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }
    
    /* Focus state for accessibility */
    &:focus-visible {
      outline: 2px solid var(--color-accent-primary);
      outline-offset: 2px;
    }

    /* Keyboard interaction states */
    &:focus:not(:focus-visible) {
      outline: none;
    }
  }
  
  /* Dark theme */
  :global(html:not([data-theme="light"])) .nav-button {
    background: rgba(26, 28, 36, 0.95);
    border: 2px solid rgba(var(--accent-rgb), 0.6);
    color: var(--color-accent-primary);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.3),
      0 4px 12px rgba(0, 0, 0, 0.4);
  }
  
  :global(html:not([data-theme="light"])) .nav-button:hover:not(:disabled) {
    background: rgba(10, 11, 15, 0.98);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 
      0 0 30px rgba(var(--accent-rgb), 0.6),
      0 0 15px rgba(var(--accent-rgb), 0.4),
      0 4px 16px rgba(0, 0, 0, 0.5);
    transform: translateY(-2px) scale(1.05);
  }
  
  :global(html:not([data-theme="light"])) .nav-button:disabled {
    background: rgba(26, 28, 36, 0.5);
    border-color: rgba(247, 250, 252, 0.2);
    color: rgba(247, 250, 252, 0.3);
    box-shadow: none;
  }
  
  /* Light theme */
  :global([data-theme="light"]) .nav-button {
    background: rgba(255, 255, 255, 0.98);
    border: 2px solid rgba(var(--accent-rgb), 0.6);
    color: var(--color-accent-primary);
    box-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.3),
      0 4px 12px rgba(0, 0, 0, 0.15);
  }
  
  :global([data-theme="light"]) .nav-button:hover:not(:disabled) {
    background: rgba(255, 255, 255, 1);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 
      0 0 30px rgba(var(--accent-rgb), 0.5),
      0 0 15px rgba(var(--accent-rgb), 0.3),
      0 4px 16px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px) scale(1.05);
  }
  
  :global([data-theme="light"]) .nav-button:disabled {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(26, 32, 44, 0.2);
    color: rgba(26, 32, 44, 0.3);
    box-shadow: none;
  }

  .nav-button__icon {
    width: 24px; /* Back to original size */
    height: 24px;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* Icon animation on hover */
  .nav-button:hover:not(:disabled) .nav-button__icon {
    transform: scale(1.1);
  }

  .nav-button--previous:hover:not(:disabled) .nav-button__icon {
    transform: scale(1.1) translateX(-1px);
  }

  .nav-button--next:hover:not(:disabled) .nav-button__icon {
    transform: scale(1.1) translateX(1px);
  }

  /* Screen reader only labels */
  .nav-button__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Responsive adjustments */
  @media (max-width: var(--breakpoint-md)) {
    .navigation-controls {
      padding: 0 var(--space-3);
    }
    
    .nav-button {
      width: 40px;
      height: 40px;
    }
    
    .nav-button__icon {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: var(--breakpoint-sm)) {
    .navigation-controls {
      padding: 0 var(--space-2);
    }
    
    .nav-button {
      width: 36px;
      height: 36px;
    }
    
    .nav-button__icon {
      width: 18px;
      height: 18px;
    }
  }

  
  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .nav-button {
      border-width: 3px;
      
      &:focus-visible {
        outline-width: 3px;
      }
    }
    
    .nav-button__icon {
      stroke-width: 2.5;
    }
  }

  /* Touch device optimizations */
  @media (hover: none) and (pointer: coarse) {
    .nav-button {
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>

<script>
  import '../../scripts/navigationControls';
</script>