---
interface Props {
  title: { en: string; id: string };
  summary: { en: string; id: string };
  status: 'completed' | 'in-progress' | 'experimental' | 'archived';
  thumbnail: string;
  link?: string;
  slug?: string;
}

const { title, status, thumbnail, link } = Astro.props;

const statusDisplay = {
  'completed': { en: 'Completed', id: 'Selesai' },
  'in-progress': { en: 'In Progress', id: 'Dalam Proses' },
  'experimental': { en: 'Experimental', id: 'Eksperimental' },
  'archived': { en: 'Archived', id: 'Diarsipkan' }
};
---

<article class="featured-card">
  <a
    href={link || '#'}
    class="featured-card__link"
    target={link ? '_blank' : undefined}
    rel={link ? 'noopener noreferrer' : undefined}
    aria-label={title.en}
  >
    <div class="featured-card__thumbnail">
      <img
        src={thumbnail}
        alt={`${title.en} thumbnail`}
        loading="lazy"
        class="featured-card__image"
      />
    </div>
    <div class="featured-card__body">
      <h3 class="featured-card__title" data-bilingual>
        <span data-lang="en">{title.en}</span>
        <span data-lang="id">{title.id}</span>
      </h3>
      <span class="featured-card__status" data-status={status} data-bilingual>
        <span data-lang="en">{statusDisplay[status].en}</span>
        <span data-lang="id">{statusDisplay[status].id}</span>
      </span>
    </div>
  </a>
</article>

<style>
  .featured-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    background: var(--bg-elevated);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    box-shadow:
      0 4px 12px var(--color-shadow-medium),
      0 2px 4px var(--color-shadow-light);
    transition:
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
    overflow: hidden;
  }

  .featured-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  :global(html:not([data-theme="light"])) .featured-card {
    border-color: rgba(246, 224, 94, 0.4);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global(html:not([data-theme="light"])) .featured-card:hover {
    border-color: rgba(246, 224, 94, 0.8);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(246, 224, 94, 0.3),
      0 0 15px rgba(246, 224, 94, 0.2);
  }

  :global([data-theme="light"]) .featured-card {
    border-color: rgba(255, 85, 0, 0.4);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="light"]) .featured-card:hover {
    border-color: rgba(255, 85, 0, 0.8);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 85, 0, 0.25),
      0 0 15px rgba(255, 85, 0, 0.15);
  }

  .featured-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .featured-card__link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }

  .featured-card__thumbnail {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.05);
  }

  .featured-card__body {
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .featured-card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin: 0;
    flex: 1;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-card:hover .featured-card__title {
    color: var(--color-accent-primary);
  }

  .featured-card__title span[data-lang] { display: none; }
  :global(html[lang="en"]) .featured-card__title span[data-lang="en"],
  :global(html[lang="id"]) .featured-card__title span[data-lang="id"] { display: inline; }

  .featured-card__status {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .featured-card__status[data-status="completed"] {
    border-color: rgba(34, 197, 94, 0.5);
    background: rgba(34, 197, 94, 0.1);
  }
  :global(html:not([data-theme="light"])) .featured-card__status[data-status="completed"] {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.5);
    background: rgba(74, 222, 128, 0.1);
  }
  :global([data-theme="light"]) .featured-card__status[data-status="completed"] {
    color: #16a34a;
    border-color: rgba(22, 163, 74, 0.5);
    background: rgba(22, 163, 74, 0.1);
  }

  .featured-card__status[data-status="in-progress"] {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.1);
  }
  :global(html:not([data-theme="light"])) .featured-card__status[data-status="in-progress"] {
    color: #60a5fa;
    border-color: rgba(96, 165, 250, 0.5);
    background: rgba(96, 165, 250, 0.1);
  }
  :global([data-theme="light"]) .featured-card__status[data-status="in-progress"] {
    color: #2563eb;
    border-color: rgba(37, 99, 163, 0.5);
    background: rgba(37, 99, 163, 0.1);
  }

  .featured-card__status[data-status="experimental"] {
    border-color: rgba(168, 85, 247, 0.5);
    background: rgba(168, 85, 247, 0.1);
  }
  :global(html:not([data-theme="light"])) .featured-card__status[data-status="experimental"] {
    color: #c084fc;
    border-color: rgba(192, 132, 252, 0.5);
    background: rgba(192, 132, 252, 0.1);
  }
  :global([data-theme="light"]) .featured-card__status[data-status="experimental"] {
    color: #9333ea;
    border-color: rgba(147, 51, 234, 0.5);
    background: rgba(147, 51, 234, 0.1);
  }

  .featured-card__status[data-status="archived"] {
    border-color: rgba(156, 163, 175, 0.5);
    background: rgba(156, 163, 175, 0.1);
  }
  :global(html:not([data-theme="light"])) .featured-card__status[data-status="archived"] {
    color: #9ca3af;
    border-color: rgba(156, 163, 175, 0.5);
    background: rgba(156, 163, 175, 0.1);
  }
  :global([data-theme="light"]) .featured-card__status[data-status="archived"] {
    color: #6b7280;
    border-color: rgba(107, 114, 128, 0.5);
    background: rgba(107, 114, 128, 0.1);
  }

  .featured-card__status span[data-lang] { display: none; }
  :global(html[lang="en"]) .featured-card__status span[data-lang="en"],
  :global(html[lang="id"]) .featured-card__status span[data-lang="id"] { display: inline; }

  @media (max-width: 480px) {
    .featured-card {
      flex: 0 0 240px;
    }

    .featured-card__body {
      padding: var(--space-3) var(--space-4);
    }

    .featured-card__title {
      font-size: var(--text-sm);
    }

    .featured-card__status {
      font-size: var(--text-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card {
      transition: none;
    }

    .featured-card:hover {
      transform: none;
    }

    .featured-card__image {
      transition: none;
    }

    .featured-card:hover .featured-card__image {
      transform: none;
    }
  }
</style>
