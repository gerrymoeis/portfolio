---
import ProjectIcon from '../projects/ProjectIcon.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
import '../../styles/project-status.css';
import '../../styles/tech-tooltip.css';
import '../../styles/card-shadows.css';
import Icon from '../ui/Icon.astro';
import { statusDisplay, linkKeys, linkLabel, linkIcon } from '../../config/projectConfig';
import type { ProjectStatus } from '../../config/projectConfig';
import type { BilingualText, ProjectLinks, ProjectLinkTitles } from '../../types';

interface Props {
  title: BilingualText;
  year: number;
  status: ProjectStatus;
  techStack: string[];
  thumbnail: string;
  links?: ProjectLinks;
  linkTitles?: ProjectLinkTitles;
}

const { title, year, status, techStack, thumbnail, links, linkTitles } = Astro.props;
---

<article class="featured-card card-shadow">
  <div class="featured-card__thumbnail">
    <OptimizedImage
      src={thumbnail}
      alt={`${title.en} thumbnail`}
      width={800}
      height={450}
      class="featured-card__image"
    />
  </div>

  <div class="featured-card__body">
    <h3 class="featured-card__title" data-bilingual>
      <span data-lang="en">{title.en}</span>
      <span data-lang="id">{title.id}</span>
    </h3>

    <div class="featured-card__meta">
      <span class="featured-card__year">{year}</span>
      <span class="featured-card__status" data-status={status} data-bilingual>
        <span data-lang="en">{statusDisplay[status].en}</span>
        <span data-lang="id">{statusDisplay[status].id}</span>
      </span>
    </div>

    <div class="featured-card__tech">
      {techStack.map(tech => (
        <div class="featured-card__tech-icon">
          <ProjectIcon name={tech} />
          <span class="tech-tooltip">{tech}</span>
        </div>
      ))}
    </div>

    {links && (
      <div class="featured-card__links">
        {linkKeys.map(key => {
          const url = links[key];
          if (!url) return null;
          const label = linkLabel(key, linkTitles);
          return (
            <a
              href={url}
              class="featured-card__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${label} - ${title.en}`}
            >
              <Icon name={linkIcon(key, linkTitles)} size="sm" />
              <span data-bilingual>
                <span data-lang="en">{label}</span>
                <span data-lang="id">{label}</span>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </div>
</article>

<style>
  .featured-card {
    background: var(--bg-elevated);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    box-shadow:
      0 4px 12px var(--color-shadow-medium),
      0 2px 4px var(--color-shadow-light);
    transition:
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 360px;
  }

  .featured-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .featured-card__thumbnail {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.05);
  }

  .featured-card__body {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    overflow: hidden;
  }

  .featured-card__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-card:hover .featured-card__title {
    color: var(--color-accent-primary);
  }

  :global(html:not([data-theme="light"])) .featured-card:hover .featured-card__title {
    color: var(--color-accent-primary);
    text-shadow:
      0 0 20px rgba(var(--accent-rgb), 0.6),
      0 0 10px rgba(var(--accent-rgb), 0.4);
  }

  :global([data-theme="light"]) .featured-card:hover .featured-card__title {
    color: var(--color-accent-primary);
    text-shadow:
      0 0 20px rgba(var(--accent-rgb), 0.5),
      0 0 10px rgba(var(--accent-rgb), 0.3);
  }



  .featured-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .featured-card__year {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
  }

  .featured-card__status {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid;
  }



  .featured-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .featured-card__tech-icon {
    position: relative;
  }

  .featured-card__tech-icon:hover .tech-tooltip,
  .featured-card__tech-icon:focus-within .tech-tooltip,
  .featured-card__tech-icon .tech-tooltip.visible {
    opacity: 1;
  }

  .featured-card__links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .featured-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    background: transparent;
    color: var(--color-accent-primary);
    text-decoration: none;
    border: 1px solid var(--color-accent-primary);
    border-radius: var(--radius-full);
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .featured-card__link:hover {
    background: var(--color-accent-primary);
    color: var(--bg-elevated);
  }

  .featured-card__link :global(.icon) {
    width: 0.875em;
    height: 0.875em;
  }

  .featured-card__link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }



</style>

<script>
  import { initTechTooltips } from '../../scripts/techTooltips';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initTechTooltips('.featured-card__tech-icon'));
  } else {
    initTechTooltips('.featured-card__tech-icon');
  }
</script>
