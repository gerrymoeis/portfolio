---
import { getCollection } from 'astro:content';
import FeaturedProjectCard from './FeaturedProjectCard.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    const pa = a.data.priority || 0;
    const pb = b.data.priority || 0;
    if (pa !== pb) return pb - pa;
    return b.data.date.getTime() - a.data.date.getTime();
  });
---

<section class="featured-section" aria-label="Featured projects">
  {featured.length > 0 && (
    <div class="featured-section__grid">
      {featured.map((project) => (
        <FeaturedProjectCard
          title={project.data.title}
          year={project.data.year}
          status={project.data.status}
          techStack={project.data.techStack}
          thumbnail={project.data.thumbnail}
          links={project.data.links}
        />
      ))}
    </div>
  )}
</section>

<style>
  .featured-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }
</style>
