---
import { getCollection } from 'astro:content';
import FeaturedProjectCard from './FeaturedProjectCard.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    const pa = a.data.priority || 0;
    const pb = b.data.priority || 0;
    if (pa !== pb) return pb - pa;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const slides: Array<typeof featured> = [];
for (let i = 0; i < featured.length; i += 2) {
  slides.push(featured.slice(i, i + 2));
}
---

<section class="carousel" aria-label="Featured projects">
  <div class="carousel__viewport">
    <div class="carousel__track" data-carousel-track>
      {slides.map((slide, slideIndex) => (
        <div class="carousel__slide" data-slide={slideIndex}>
          {slide.length === 2 ? (
            <div class="carousel__grid">
              {slide.map((project) => (
                <FeaturedProjectCard
                  title={project.data.title}
                  year={project.data.year}
                  status={project.data.status}
                  techStack={project.data.techStack}
                  thumbnail={project.data.thumbnail}
                  links={project.data.links}
                  linkTitles={project.data.linkTitles}
                />
              ))}
            </div>
          ) : (
            <div class="carousel__single">
              <FeaturedProjectCard
                title={slide[0].data.title}
                year={slide[0].data.year}
                status={slide[0].data.status}
                techStack={slide[0].data.techStack}
                thumbnail={slide[0].data.thumbnail}
                links={slide[0].data.links}
                linkTitles={slide[0].data.linkTitles}
              />
            </div>
          )}
        </div>
      ))}
    </div>

    {slides.length > 1 && (
      <>
        <button class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="Previous slide">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="carousel__btn carousel__btn--next" data-carousel-next aria-label="Next slide">
          <i class="fas fa-chevron-right"></i>
        </button>
        <div class="carousel__dots" data-carousel-dots>
          {slides.map((_, i) => (
            <button
              class="carousel__dot"
              data-carousel-dot={i}
              aria-label={`Go to slide ${i + 1}`}
            ></button>
          ))}
        </div>
      </>
    )}
  </div>
</section>

<script>
  (function () {
    const track = document.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;

    const viewport = track.closest('.carousel__viewport') as HTMLElement;
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = document.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]');

    function getSlideIndex(): number {
      if (!track) return 0;
      const slideWidth = track.children[0]?.clientWidth || 1;
      return Math.round(track.scrollLeft / slideWidth);
    }

    function updateDots() {
      const active = getSlideIndex();
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
      });
    }

    function scrollToSlide(index: number) {
      if (!track) return;
      const slideWidth = track.children[0]?.clientWidth || 0;
      track.scrollTo({ left: index * slideWidth, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => {
      scrollToSlide(getSlideIndex() - 1);
    });

    nextBtn?.addEventListener('click', () => {
      scrollToSlide(getSlideIndex() + 1);
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-carousel-dot') || '0', 10);
        scrollToSlide(idx);
      });
    });

    track.addEventListener('scroll', updateDots, { passive: true });

    updateDots();
  })();
</script>

<style>
  .carousel__viewport {
    position: relative;
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 0;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    height: 100%;
    display: flex;
    align-items: stretch;
  }

  .carousel__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    width: 100%;
    align-items: stretch;
  }

  .carousel__grid > * {
    height: 100%;
  }

  .carousel__single {
    display: flex;
    justify-content: center;
    align-items: stretch;
    width: 100%;
  }

  .carousel__single > * {
    width: calc(50% - var(--space-3));
    max-width: 480px;
  }

  .carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 2px solid var(--color-accent-primary);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--color-accent-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    opacity: 0.85;
  }

  .carousel__btn:hover {
    background: var(--color-accent-primary);
    color: var(--bg-elevated);
    opacity: 1;
  }

  .carousel__btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel__btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .carousel__btn--prev {
    left: var(--space-2);
  }

  .carousel__btn--next {
    right: var(--space-2);
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) 0 0;
    flex-shrink: 0;
  }

  .carousel__dot {
    width: 10px;
    height: 10px;
    border: 2px solid var(--color-accent-primary);
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition:
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .carousel__dot.is-active {
    background: var(--color-accent-primary);
    transform: scale(1.3);
  }

  .carousel__dot:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  @media (max-width: var(--breakpoint-sm)) {
    .carousel__grid {
      grid-template-columns: 1fr;
    }

    .carousel__single > * {
      width: 100%;
      max-width: none;
    }

    .carousel__btn {
      display: none;
    }

    .carousel__dots {
      padding: var(--space-2) 0 0;
    }
  }

</style>
