---
/**
 * Footer - Site footer component
 * HD-2D styled footer for all pages except home
 * Contains copyright, social links, and navigation with active states
 * 
 * Props:
 * - currentPath: Current page path for active state detection (optional)
 */

import Icon from './Icon.astro';
import { homeConfig } from '../../config/home';

interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Social links - GitHub and Email only
const socialLinks = [
  { name: "GitHub", url: "https://github.com/gerrymoeis", icon: "github" },
  { name: "Email", url: "mailto:gerrymoeis7@gmail.com", icon: "email" },
];

const currentYear = new Date().getFullYear();

// Get current path for active state (fallback to Astro.url.pathname if not provided)
const activePath = currentPath || Astro.url.pathname;

// Helper function to determine if a link is active
const isLinkActive = (linkHref: string): boolean => {
  if (linkHref === '/') {
    return activePath === '/';
  }
  // For CV link, never show as active
  if (linkHref.endsWith('.pdf')) {
    return false;
  }
  return activePath.startsWith(linkHref);
};
---

<footer class="footer depth-mid" role="contentinfo">
  <div class="footer__container">
    <div class="footer__content">
      <!-- Navigation Links -->
      <!-- <nav class="footer__nav" aria-label="Footer navigation">
        <ul class="footer__nav-list">
          {navLinks.map((link) => {
            const isActive = isLinkActive(link.href);
            
            return (
              <li class="footer__nav-item">
                <a 
                  href={link.href} 
                  class:list={['footer__nav-link', { 'footer__nav-link--active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                  target={link.target}
                  rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
                  download={link.download}
                  data-bilingual="footer-nav"
                >
                  <span data-lang="en">{link.label.en}</span>
                  <span data-lang="id">{link.label.id}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav> -->

      <!-- Social Links -->
      <div class="footer__social">
        <ul class="footer__social-list">
          {socialLinks.map((link) => (
            <li class="footer__social-item">
              <a 
                href={link.url} 
                class="footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${link.name} (opens in new tab)`}
              >
                <Icon name={link.icon} class="footer__social-icon" />
                <span class="footer__social-name">{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Copyright -->
      <div class="footer__copyright">
        <p class="footer__copyright-text">
          © {currentYear} Gerry Moeis Portfolio.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-elevated);
    border-top: 2px solid var(--color-border-accent);
    box-shadow: 
      0 -4px 16px var(--color-shadow-medium),
      0 -2px 8px var(--color-shadow-light);
    position: relative;
    overflow: hidden;
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-12);
    position: relative;
    z-index: 1;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  /* Navigation - Simple horizontal list */
  .footer__nav {
    width: 100%;
  }
  
  .footer__nav-list {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__nav-item {
    margin: 0;
  }

  .footer__nav-link {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    position: relative;
    transition: 
      color var(--duration-medium) var(--ease-out),
      background-color var(--duration-medium) var(--ease-out);
  }
  
  /* Hide inactive language */
  .footer__nav-link span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .footer__nav-link span[data-lang="en"],
  :global(html[lang="id"]) .footer__nav-link span[data-lang="id"] {
    display: inline;
  }

  .footer__nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-nav-hover-bg);
  }

  .footer__nav-link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .footer__nav-link--active {
    color: var(--color-text-primary);
    background-color: var(--color-nav-active-bg);
    font-weight: var(--weight-semibold);
  }
  
  /* Dark theme hover/active */
  :global(html:not([data-theme="light"])) .footer__nav-link:hover {
    background-color: rgba(246, 224, 94, 0.15);
  }
  
  :global(html:not([data-theme="light"])) .footer__nav-link--active {
    background-color: rgba(246, 224, 94, 0.25);
  }
  
  /* Light theme hover/active */
  :global([data-theme="light"]) .footer__nav-link:hover {
    background-color: rgba(255, 85, 0, 0.15);
  }
  
  :global([data-theme="light"]) .footer__nav-link--active {
    background-color: rgba(255, 85, 0, 0.25);
  }

  /* Social Links */
  .footer__social {
    width: 100%;
    justify-content: center;
  }
  
  .footer__social-list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .footer__social-item {
    margin: 0;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-primary);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-full);
    transition: 
      color var(--duration-medium) var(--ease-out),
      background-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-social-hover-bg);
    transform: translateY(-1px);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .footer__social-icon {
    font-size: var(--text-2xl);
    line-height: 1;
    flex-shrink: 0;
  }

  /* Copyright */
  .footer__copyright-text {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
  
  /* Light mode copyright - better contrast */
  :global([data-theme="light"]) .footer__copyright-text {
    color: var(--color-text-primary);
    opacity: 0.8;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .footer__container {
      padding: var(--space-12);
    }

    .footer__content {
      gap: var(--space-8);
      align-items: flex-start;
      text-align: left;
    }
    
    /* Create 2 column layout wrapper */
    .footer__nav,
    .footer__social {
      width: 100%;
    }
    
    /* Navigation Links - Left column, vertical stack */
    .footer__nav-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      align-items: flex-start;
    }
    
    .footer__nav-item {
      text-align: left;
    }
    
    .footer__nav-link {
      padding: var(--space-2) var(--space-3);
      display: inline-block;
      width: auto;
    }
    
    /* Social Links - Right column, vertical stack */
    .footer__social-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      align-items: flex-start;
    }
    
    .footer__social-link {
      padding: var(--space-2) var(--space-3);
      justify-content: flex-start;
    }
    
    .footer__social-icon {
      font-size: var(--text-xl);
    }
    
    /* Create side-by-side layout for nav and social */
    .footer__content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-8) var(--space-6);
    }
    
    .footer__nav {
      grid-column: 1;
      grid-row: 1;
    }
    
    .footer__social {
      grid-column: 2;
      grid-row: 1;
    }
    
    /* Copyright - Full width, centered */
    .footer__copyright {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      text-align: center;
    }
    
    .footer__copyright-text {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .footer__container {
      padding: var(--space-12) var(--space-4) var(--space-12);
    }
    
    .footer__content {
      gap: var(--space-6) var(--space-4);
    }

    .footer__nav-list {
      gap: var(--space-2);
    }

    .footer__nav-link {
      font-size: var(--text-sm);
      padding: var(--space-1) var(--space-2);
    }
    
    .footer__social-list {
      gap: var(--space-2);
    }
    
    .footer__social-link {
      font-size: var(--text-base);
      padding: var(--space-2) var(--space-2);
      gap: var(--space-2);
    }
    
    .footer__social-icon {
      font-size: var(--text-lg);
    }
    
    .footer__social-name {
      font-size: var(--text-sm);
    }
    
    .footer__copyright-text {
      font-size: var(--text-sm);
    }
  }
</style>