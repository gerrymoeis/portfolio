---
/**
 * Footer - Site footer component
 * HD-2D styled footer for all pages except home
 * Contains copyright and social links only
 * 
 * Props: None
 */

import Icon from './Icon.astro';

// Social links - GitHub and Email only
const socialLinks = [
  { name: "GitHub", url: "https://github.com/gerrymoeis", icon: "github" },
  { name: "Email", url: "mailto:gerrymoeis7@gmail.com", icon: "email" },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer depth-mid" role="contentinfo">
  <div class="footer__container">
    <div class="footer__content">
      <!-- Social Links -->
      <div class="footer__social">
        <ul class="footer__social-list">
          {socialLinks.map((link) => (
            <li class="footer__social-item">
              <a 
                href={link.url} 
                class="footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${link.name} (opens in new tab)`}
              >
                <Icon name={link.icon} class="footer__social-icon" />
                <span class="footer__social-name">{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Copyright -->
      <div class="footer__copyright">
        <p class="footer__copyright-text">
          © {currentYear} Gerry Moeis Portfolio.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-elevated);
    border-top: 2px solid var(--color-border-accent);
    box-shadow: 
      0 -4px 16px var(--color-shadow-medium),
      0 -2px 8px var(--color-shadow-light);
    position: relative;
    overflow: hidden;
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-12);
    position: relative;
    z-index: 1;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  /* Social Links - Horizontal for desktop */
  .footer__social {
    width: 100%;
  }
  
  .footer__social-list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .footer__social-item {
    margin: 0;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-primary);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-full);
    transition: 
      color var(--duration-medium) var(--ease-out),
      background-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    justify-content: center;
  }

  .footer__social-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-social-hover-bg);
    transform: translateY(-1px);
  }

  .footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .footer__social-icon {
    font-size: var(--text-2xl);
    line-height: 1;
    flex-shrink: 0;
  }

  /* Copyright */
  .footer__copyright-text {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
  
  /* Light mode copyright - better contrast */
  :global([data-theme="light"]) .footer__copyright-text {
    color: var(--color-text-primary);
    opacity: 0.8;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .footer__container {
      padding: var(--space-12);
    }

    .footer__content {
      gap: var(--space-6);
    }
    
    /* Social Links - Vertical stack on mobile, center aligned */
    .footer__social-list {
      flex-direction: column;
      gap: var(--space-3);
      align-items: center;
    }
    
    .footer__social-item {
      width: auto;
    }
    
    .footer__social-link {
      padding: var(--space-2) var(--space-3);
      justify-content: center;
    }
    
    .footer__social-icon {
      font-size: var(--text-xl);
    }
    
    .footer__copyright-text {
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 480px) {
    .footer__container {
      padding: var(--space-12) var(--space-4) var(--space-12);
    }
    
    .footer__content {
      gap: var(--space-6) var(--space-4);
    }

    .footer__nav-list {
      gap: var(--space-2);
    }

    .footer__nav-link {
      font-size: var(--text-sm);
      padding: var(--space-1) var(--space-2);
    }
    
    .footer__social-list {
      gap: var(--space-2);
    }
    
    .footer__social-link {
      font-size: var(--text-base);
      padding: var(--space-2) var(--space-2);
      gap: var(--space-2);
    }
    
    .footer__social-icon {
      font-size: var(--text-lg);
    }
    
    .footer__social-name {
      font-size: var(--text-sm);
    }
    
    .footer__copyright-text {
      font-size: var(--text-sm);
    }
  }
</style>