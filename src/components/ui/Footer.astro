---
/**
 * Footer - Site footer component
 * HD-2D styled footer for all pages except home
 * Contains copyright, social links, navigation with active states, and CV download
 * 
 * Props:
 * - currentPath: Current page path for active state detection (optional)
 */

import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

interface SocialLink {
  name: string;
  url: string;
  icon: string;
}

const { currentPath } = Astro.props;

// Social links - removed Twitter and LinkedIn, added Email
const socialLinks: SocialLink[] = [
  { name: "GitHub", url: "https://github.com/yourusername", icon: "github" },
  { name: "Email", url: "mailto:your.email@example.com", icon: "email" },
];

// Navigation links with bilingual support - Order: Home, Projects, Blogs
const navLinks = [
  { label: { id: 'Beranda', en: 'Home' }, href: '/', target: undefined },
  { label: { id: 'Proyek', en: 'Projects' }, href: '/projects', target: '_blank' },
  { label: { id: 'Blog', en: 'Blogs' }, href: '/blogs', target: '_blank' },
];

const currentYear = new Date().getFullYear();

// Get current path for active state (fallback to Astro.url.pathname if not provided)
const activePath = currentPath || Astro.url.pathname;
---

<footer class="footer depth-mid" role="contentinfo">
  <div class="footer__container">
    <div class="footer__content">
      <!-- Navigation Links -->
      <nav class="footer__nav" aria-label="Footer navigation">
        <div class="footer__nav-row">
          <ul class="footer__nav-list">
            {navLinks.map((link) => {
              const isActive = activePath === link.href || 
                              (link.href !== '/' && activePath.startsWith(link.href));
              
              return (
                <li class="footer__nav-item">
                  <a 
                    href={link.href} 
                    class:list={['footer__nav-link', { 'footer__nav-link--active': isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                    target={link.target}
                    rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
                    data-bilingual="footer-nav"
                  >
                    <span data-lang="en">{link.label.en}</span>
                    <span data-lang="id">{link.label.id}</span>
                  </a>
                </li>
              );
            })}
            <!-- CV Download Button - Inline with nav links (Desktop only) -->
            <li class="footer__nav-item footer__nav-item--cv footer__nav-item--cv-desktop">
              <a 
                href="/cv.pdf" 
                class="footer__cv-button"
                download
                aria-label="Download CV"
                data-bilingual="cv-button"
              >
                <Icon name="download" class="footer__cv-icon" />
                <span data-lang="en">Download my CV</span>
                <span data-lang="id">Unduh CV saya</span>
              </a>
            </li>
          </ul>
        </div>
        
        <!-- Second Row: Social Links -->
        <div class="footer__social">
          <!-- CV Download Button - Mobile only (appears before social links) -->
          <a 
            href="/cv.pdf" 
            class="footer__cv-button footer__cv-button--mobile"
            download
            aria-label="Download CV"
            data-bilingual="cv-button"
          >
            <Icon name="download" class="footer__cv-icon" />
            <span data-lang="en">Download my CV</span>
            <span data-lang="id">Unduh CV saya</span>
          </a>
          
          <ul class="footer__social-list">
            {socialLinks.map((link) => (
              <li class="footer__social-item">
                <a 
                  href={link.url} 
                  class="footer__social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${link.name} (opens in new tab)`}
                >
                  <Icon name={link.icon} class="footer__social-icon" />
                  <span class="footer__social-name">{link.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <!-- Copyright -->
      <div class="footer__copyright">
        <p class="footer__copyright-text">
          © {currentYear} Gerry Moeis Portfolio.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-elevated);
    border-top: var(--panel-border-width) var(--panel-border-style) var(--color-accent-primary);
    box-shadow: 
      var(--panel-shadow-elevated),
      var(--atmospheric-glow);
    position: relative;
    overflow: hidden;
  }

  .footer__container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-8);
    position: relative;
    z-index: 1;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  /* Navigation - Desktop: Two rows */
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: center;
    width: 100%;
  }
  
  /* First row wrapper */
  .footer__nav-row {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  
  /* First row: Nav links + CV button (all inline) */
  .footer__nav-list {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__nav-item {
    margin: 0;
  }
  
  .footer__nav-item--cv {
    /* CV button inline with nav links */
    margin-left: var(--space-2);
  }
  
  /* Second row: Social links */
  .footer__social {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  
  /* Social links list */
  .footer__social-list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .footer__nav-link {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    position: relative;
    transition: 
      color var(--duration-medium) var(--ease-out),
      background-color var(--duration-medium) var(--ease-out);
  }
  
  /* Hide inactive language */
  .footer__nav-link span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .footer__nav-link span[data-lang="en"],
  :global(html[lang="id"]) .footer__nav-link span[data-lang="id"] {
    display: inline;
  }

  .footer__nav-link:hover {
    color: var(--color-contrast-high);
    background-color: var(--color-nav-hover-bg);
  }

  .footer__nav-link:focus-visible {
    outline: var(--focus-outline-width) var(--focus-outline-style) var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }

  .footer__nav-link--active {
    color: var(--color-contrast-high);
    background-color: var(--color-nav-active-bg);
    font-weight: var(--weight-semibold);
    box-shadow: var(--subtle-glow);
  }

  .footer__nav-link--active::after {
    content: '';
    position: absolute;
    bottom: calc(-1 * var(--space-1));
    left: 50%;
    transform: translateX(-50%);
    width: var(--nav-indicator-width);
    height: var(--nav-indicator-height);
    background-color: var(--color-nav-active-indicator);
    border-radius: var(--radius-xs);
    box-shadow: 0 0 var(--space-1) var(--color-nav-active-indicator);
  }
  
  /* CV Download Button */
  .footer__cv-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    transition: all var(--duration-medium) ease;
    box-shadow: 0 0 20px rgba(246, 224, 94, 0.3);
  }
  
  /* CV Download Button */
  .footer__cv-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
    font-family: var(--font-primary);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    transition: all var(--duration-medium) ease;
    box-shadow: 0 0 20px rgba(246, 224, 94, 0.3);
  }
  
  /* Hide mobile CV button on desktop */
  .footer__cv-button--mobile {
    display: none;
  }
  
  /* Dark theme CV button */
  :global(html:not([data-theme="light"])) .footer__cv-button {
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
  }
  
  :global(html:not([data-theme="light"])) .footer__cv-button:hover {
    background: var(--color-bg-dark);
    color: #f6e05e;
    border-color: #f6e05e;
    box-shadow: 
      0 0 40px rgba(246, 224, 94, 0.8),
      0 0 20px rgba(246, 224, 94, 0.6),
      inset 0 0 20px rgba(246, 224, 94, 0.1);
    text-shadow: 0 0 10px rgba(246, 224, 94, 0.8);
    transform: translateY(-2px);
  }
  
  /* Light theme CV button */
  :global([data-theme="light"]) .footer__cv-button {
    background: #ff5500;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(255, 85, 0, 0.3);
  }
  
  :global([data-theme="light"]) .footer__cv-button:hover {
    background: #ffffff;
    color: #ff5500;
    border-color: #ff5500;
    box-shadow: 
      0 0 40px rgba(255, 85, 0, 0.8),
      0 0 20px rgba(255, 85, 0, 0.6),
      inset 0 0 20px rgba(255, 85, 0, 0.1);
    text-shadow: 0 0 10px rgba(255, 85, 0, 0.8);
    transform: translateY(-2px);
  }
  
  .footer__cv-button:focus-visible {
    outline: var(--focus-outline-width) var(--focus-outline-style) var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }
  
  .footer__cv-button:active {
    transform: translateY(0);
  }
  
  .footer__cv-icon {
    font-size: var(--text-lg);
    line-height: 1;
  }
  
  /* Hide inactive language for CV button */
  .footer__cv-button span[data-lang] {
    display: none;
  }
  
  /* Show active language for CV button */
  :global(html[lang="en"]) .footer__cv-button span[data-lang="en"],
  :global(html[lang="id"]) .footer__cv-button span[data-lang="id"] {
    display: inline;
  }

  /* Social Links */
  .footer__social-item {
    margin: 0;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-primary);
    font-size: var(--text-lg); /* Larger text size */
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    transition: 
      color var(--duration-medium) var(--ease-out),
      background-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--color-contrast-high);
    background-color: var(--color-social-hover-bg);
    transform: var(--transform-hover-lift);
  }

  .footer__social-link:focus-visible {
    outline: var(--focus-outline-width) var(--focus-outline-style) var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }

  .footer__social-icon {
    font-size: var(--text-2xl); /* Larger icon size */
    line-height: 1;
    flex-shrink: 0;
  }

  /* Copyright */
  .footer__copyright-text {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
  }
  
  /* Light mode copyright - better contrast */
  :global([data-theme="light"]) .footer__copyright-text {
    color: var(--color-text-primary);
    opacity: 0.8;
  }

  /* Responsive adjustments - Mobile First */
  
  /* Tablet/Small Desktop (769px - 1024px) - Maintain desktop layout but adjust spacing */
  @media (min-width: 769px) and (max-width: 1024px) {
    .footer__container {
      padding: var(--space-10) var(--space-5) var(--space-8);
    }
    
    .footer__nav-list {
      gap: var(--space-4);
    }
    
    .footer__nav-link {
      font-size: var(--text-sm);
      padding: var(--space-2) var(--space-2);
    }
    
    .footer__cv-button {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
    }
    
    .footer__social-list {
      gap: var(--space-5);
    }
    
    .footer__social-link {
      font-size: var(--text-base);
      padding: var(--space-2) var(--space-3);
    }
  }
  
  /* Mobile (≤768px) - 2 Column Layout */
  @media (max-width: 768px) {
    .footer__container {
      padding: var(--space-10) var(--space-5) var(--space-8);
    }

    .footer__content {
      gap: var(--space-8);
      align-items: flex-start;
      text-align: left;
    }

    /* Two Column Layout for Mobile */
    .footer__nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      align-items: start;
      width: 100%;
    }
    
    /* First column: Nav links only */
    .footer__nav-row {
      grid-column: 1;
      justify-content: flex-start;
    }

    /* Navigation Links - Left Column */
    .footer__nav-list {
      flex-direction: column;
      gap: var(--space-4);
      align-items: flex-start;
      justify-content: flex-start;
    }
    
    .footer__nav-item {
      width: auto;
      margin: 0;
    }
    
    /* Hide desktop CV button on mobile */
    .footer__nav-item--cv-desktop {
      display: none;
    }
    
    .footer__nav-link {
      width: auto;
      text-align: left;
      display: inline-block;
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-base);
      border-radius: var(--radius-sm);
    }
    
    .footer__nav-link:hover {
      background-color: var(--color-nav-hover-bg);
      padding: var(--space-2) var(--space-3);
    }
    
    .footer__nav-link--active {
      background-color: var(--color-nav-active-bg);
      padding: var(--space-2) var(--space-3);
    }
    
    /* Second column: CV button + Social links */
    .footer__social {
      grid-column: 2;
      justify-content: flex-start;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    
    /* Show mobile CV button */
    .footer__cv-button--mobile {
      display: inline-flex;
      width: 100%;
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-sm);
      justify-content: center;
    }

    /* Social Links - Right Column */
    .footer__social-list {
      flex-direction: column;
      gap: var(--space-4);
      align-items: flex-start;
    }

    .footer__social-link {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: var(--space-2) var(--space-3);
      gap: var(--space-2);
      width: auto;
      border-radius: var(--radius-sm);
    }
    
    .footer__social-link:hover {
      background-color: var(--color-social-hover-bg);
      padding: var(--space-2) var(--space-3);
    }

    .footer__social-name {
      font-size: var(--text-base);
    }
    
    .footer__social-icon {
      font-size: var(--text-xl);
    }
    
    /* Copyright - Full Width, Centered */
    .footer__copyright {
      width: 100%;
      text-align: center;
      margin-top: var(--space-4);
      grid-column: 1 / -1;
    }
    
    .footer__copyright-text {
      font-size: var(--text-sm);
      padding: 0 var(--space-4);
    }
  }

  /* Small Mobile (≤480px) - Tighter spacing */
  @media (max-width: 480px) {
    .footer__container {
      padding: var(--space-8) var(--space-4) var(--space-6);
    }
    
    .footer__content {
      gap: var(--space-6);
    }
    
    /* Maintain 2-column layout on small mobile */
    .footer__nav {
      gap: var(--space-4);
      grid-template-columns: 1fr 1fr;
    }

    .footer__nav-list {
      gap: var(--space-3);
    }

    .footer__nav-link {
      font-size: var(--text-sm);
      padding: var(--space-2) var(--space-2);
    }
    
    .footer__nav-link:hover,
    .footer__nav-link--active {
      padding: var(--space-2) var(--space-2);
    }
    
    .footer__actions {
      gap: var(--space-3);
    }
    
    .footer__cv-button {
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-xs);
      gap: var(--space-1);
    }
    
    .footer__cv-icon {
      font-size: var(--text-base);
    }
    
    .footer__social-list {
      gap: var(--space-3);
    }
    
    .footer__social-link {
      font-size: var(--text-sm);
      padding: var(--space-2) var(--space-2);
      gap: var(--space-2);
    }
    
    .footer__social-link:hover {
      padding: var(--space-2) var(--space-2);
    }
    
    .footer__social-icon {
      font-size: var(--text-lg);
    }
    
    .footer__social-name {
      font-size: var(--text-sm);
    }
    
    .footer__copyright-text {
      font-size: var(--text-xs);
    }
  }
</style>