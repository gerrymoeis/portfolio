---
/**
 * Page Background Gradient Component
 * Renders a seamless gradient at the top of pages
 * Uses --bg-elevated as base color with lightness variations
 * Automatically theme-aware (light/dark)
 */
---

<div class="page-gradient"></div>

<style>
  .page-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 600px;
    pointer-events: none;
    z-index: 0;
  }
  
  /* Dark theme gradient - base color #1a1c24 with lightness variations */
  :global(html:not([data-theme="light"])) .page-gradient {
    background: 
      radial-gradient(
        ellipse 160% 140% at 50% 0%,
        color-mix(in srgb, var(--bg-elevated) 100%, white 35%) 0%,
        color-mix(in srgb, var(--bg-elevated) 100%, white 20%) 15%,
        color-mix(in srgb, var(--bg-elevated) 100%, white 8%) 35%,
        color-mix(in srgb, var(--bg-elevated) 100%, white 0%) 55%,
        var(--bg-elevated) 75%,
        var(--bg-elevated) 100%
      ),
      radial-gradient(
        circle at 30% 15%, 
        rgba(var(--accent-rgb), 0.04) 0%, 
        transparent 55%
      ),
      radial-gradient(
        circle at 70% 20%, 
        rgba(139, 149, 109, 0.03) 0%, 
        transparent 50%
      );
  }
  
  /* Light theme gradient - base color #f7fafc with darkness variations */
  :global([data-theme="light"]) .page-gradient {
    background: 
      radial-gradient(
        ellipse 160% 140% at 50% 0%,
        color-mix(in srgb, var(--bg-elevated) 100%, black 60%) 0%,
        color-mix(in srgb, var(--bg-elevated) 100%, black 40%) 15%,
        color-mix(in srgb, var(--bg-elevated) 100%, black 20%) 35%,
        color-mix(in srgb, var(--bg-elevated) 100%, black 0%) 55%,
        var(--bg-elevated) 75%,
        var(--bg-elevated) 100%
      ),
      radial-gradient(
        circle at 30% 15%, 
        rgba(var(--accent-rgb), 0.06) 0%, 
        transparent 55%
      ),
      radial-gradient(
        circle at 70% 20%, 
        rgba(237, 137, 54, 0.04) 0%, 
        transparent 50%
      );
  }
  
  /* Mobile - smaller gradient area */
  @media (max-width: 768px) {
    .page-gradient {
      height: 400px;
    }
  }
</style>
