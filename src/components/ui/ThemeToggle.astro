  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--bg-elevated);
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.15s ease;
    color: var(--color-text-primary);
  }
  
  .theme-toggle:hover {
    background: var(--bg-surface);
    border-color: var(--color-border-accent);
    transform: translateY(-1px);
  }
  
  .theme-toggle:hover {
    color: var(--color-accent-primary);
  }
  
  .theme-toggle:active {
    transform: translateY(0);
  }
  
  .theme-toggle:focus-visible {
    outline: var(--focus-outline-width) var(--focus-outline-style) var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
  }
  
  .theme-icon {
    position: absolute;
    width: 18px;
    height: 18px;
    transition: opacity 0.3s ease, transform 0.3s ease;
    opacity: 0;
    transform: scale(0);
  }
  
  :global([data-theme="dark"]) .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  
  :global([data-theme="dark"]) .moon-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0);
  }
  
  :global([data-theme="light"]) .sun-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0);
  }
  
  :global([data-theme="light"]) .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  
</style>

<script>
  import { toggleTheme, getCurrentTheme } from '../../scripts/theme';
  
  function initThemeToggle() {
    const buttons = document.querySelectorAll('[data-theme-toggle]');
    if (!buttons.length) return;
    
    function updateAriaLabel() {
      const theme = getCurrentTheme();
      const label = theme === 'dark' 
        ? 'Switch to light theme' 
        : 'Switch to dark theme';
      
      buttons.forEach(button => {
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
      });
    }
    
    updateAriaLabel();
    
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        toggleTheme();
        updateAriaLabel();
      });
    });
    
    window.addEventListener('themechange', updateAriaLabel);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
  
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
