<button
  class="theme-toggle"
  data-theme-toggle
  aria-label="Toggle theme"
  title="Toggle theme"
  type="button"
>
  <svg class="theme-icon sun-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
