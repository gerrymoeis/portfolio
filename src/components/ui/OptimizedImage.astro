---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  className?: string;
  decoding?: 'async' | 'sync' | 'auto';
}

const { src, alt, width, height, loading = 'lazy', fetchpriority = 'auto', className = '', decoding = 'async' } = Astro.props;
---

<img
  {src}
  {alt}
  {width}
  {height}
  {loading}
  {fetchpriority}
  {decoding}
  class={className}
/>
