---
import { craftBadgeLabels } from '../../data/craftBadges'

interface Props {
  craft: 'ai' | 'hand-crafted'
}

const { craft } = Astro.props
const labels = craftBadgeLabels[craft]
---

<div class="craft-badge" data-craft={craft} data-bilingual>
  <span data-lang="en">{labels.en}</span>
  <span data-lang="id">{labels.id}</span>
</div>

<style>
  .craft-badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 5;
    padding: 3px 2.5em;
    font-family: var(--font-primary);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--color-text-primary);
    text-align: center;
    white-space: nowrap;
    transform:
      translateY(-100%)
      rotate(90deg)
      translateX(50%)
      rotate(-45deg);
    transform-origin: bottom right;
    pointer-events: none;
    user-select: none;
  }

  .craft-badge[data-craft="ai"] {
    background: var(--craft-ai-bg);
  }

  .craft-badge[data-craft="hand-crafted"] {
    background: var(--craft-handcrafted-bg);
  }



  @media (max-width: var(--breakpoint-lg)) {
    .craft-badge {
      padding: 2px 1.5em;
      font-size: 8px;
    }
  }
</style>
