---
/**
 * ProjectIcon - Tech stack icon with light/dark theme support
 * Primary: tech-stack-icons (690+ icons, built-in light/dark variants)
 * Fallback: simple-icons (for techs not in tech-stack-icons)
 * 
 * Fixes SVG ID conflicts by making clipPath/gradient IDs unique per instance
 */

import { getTechIcon } from '../../data/techIcons';
import {
  siJavascript, siGin, siHtmx, siAxios, siLatex, siAnimedotjs, siJsonwebtokens,
  siReact, siBootstrap
} from 'simple-icons';

interface Props {
  name: string;
}

const { name } = Astro.props;

// Unique ID prefix for this icon instance to avoid SVG ID conflicts
const uid = name.replace(/[^a-zA-Z0-9]/g, '').toLowerCase() + Math.random().toString(36).slice(2, 6);

/**
 * Make SVG IDs unique by adding a prefix
 * This prevents clip-path and gradient conflicts when multiple icons render
 */
function makeSvgIdsUnique(svg: string, prefix: string): string {
  const idRegex = /\bid="([^"]+)"/g;
  const ids = new Set<string>();
  let match;
  while ((match = idRegex.exec(svg)) !== null) {
    ids.add(match[1]);
  }
  if (ids.size === 0) return svg;

  let result = svg;
  for (const id of ids) {
    const newId = `${prefix}-${id}`;
    result = result.replaceAll(`id="${id}"`, `id="${newId}"`);
    result = result.replaceAll(`url(#${id})`, `url(#${newId})`);
    result = result.replaceAll(`href="#${id}"`, `href="#${newId}"`);
  }
  return result;
}

// Try tech-stack-icons first
const iconData = getTechIcon(name);
let hasThemeVariants = false;
let lightSvg = '';
let darkSvg = '';
let isFallback = false;

if (iconData) {
  lightSvg = iconData.light || iconData.svg || '';
  darkSvg = iconData.dark || '';
  hasThemeVariants = !!iconData.dark;
  // Make SVG IDs unique
  lightSvg = makeSvgIdsUnique(lightSvg, uid);
  if (darkSvg) {
    darkSvg = makeSvgIdsUnique(darkSvg, uid + 'd');
  }
} else {
  isFallback = true;
  const fallbackIcons: Record<string, any> = {
    'JavaScript': siJavascript,
    'Gin': siGin,
    'HTMX': siHtmx,
    'Axios': siAxios,
    'LaTeX': siLatex,
    'Anime.js': siAnimedotjs,
    'JSON Web Tokens': siJsonwebtokens,
    'React': siReact,
    'Bootstrap': siBootstrap,
  };
  const icon = fallbackIcons[name];
  if (icon) {
    lightSvg = `<svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="${name}"><path d="${icon.path}" fill="currentColor"/></svg>`;
  }
}
---

{
  lightSvg ? (
    <div class="project-icon" title={name}>
      {hasThemeVariants ? (
        <>
          <div class="project-icon__light" set:html={lightSvg} />
          <div class="project-icon__dark" set:html={darkSvg} />
        </>
      ) : (
        <div class="project-icon__single" set:html={lightSvg} data-fallback={isFallback ? 'true' : 'false'} />
      )}
    </div>
  ) : (
    <span class="project-icon__text" title={name}>{name}</span>
  )
}

<style>
  .project-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: help;
    transition: all var(--duration-fast) var(--ease-out);
    border-radius: var(--radius-md);
    padding: 6px;
    position: relative;
    flex-shrink: 0;
  }

  .project-icon:hover {
    transform: scale(1.1);
  }

  :global(html:not([data-theme="light"])) .project-icon {
    box-shadow: 
      0 0 10px rgba(246, 224, 94, 0.4),
      0 0 6px rgba(246, 224, 94, 0.3),
      inset 0 0 6px rgba(246, 224, 94, 0.2);
  }

  :global(html:not([data-theme="light"])) .project-icon:hover {
    box-shadow: 
      0 0 16px rgba(246, 224, 94, 0.6),
      0 0 10px rgba(246, 224, 94, 0.4),
      inset 0 0 8px rgba(246, 224, 94, 0.3);
  }

  :global([data-theme="light"]) .project-icon {
    box-shadow: 
      0 0 10px rgba(255, 85, 0, 0.4),
      0 0 6px rgba(255, 85, 0, 0.3),
      inset 0 0 6px rgba(255, 85, 0, 0.2);
  }

  :global([data-theme="light"]) .project-icon:hover {
    box-shadow: 
      0 0 16px rgba(255, 85, 0, 0.6),
      0 0 10px rgba(255, 85, 0, 0.4),
      inset 0 0 8px rgba(255, 85, 0, 0.3);
  }

  .project-icon__light,
  .project-icon__dark,
  .project-icon__single {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-icon__light :global(svg),
  .project-icon__dark :global(svg),
  .project-icon__single :global(svg) {
    width: 100%;
    height: 100%;
  }

  .project-icon__dark { display: none; }
  :global(html:not([data-theme="light"])) .project-icon__light { display: none; }
  :global(html:not([data-theme="light"])) .project-icon__dark { display: flex; }

  .project-icon__single[data-fallback="true"] :global(svg) {
    fill: currentColor;
  }

  .project-icon__text {
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background-color: var(--color-social-hover-bg-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-medium);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-icon { transition: none; }
    .project-icon:hover { transform: none; }
  }
</style>

<script>
  const THEME_COLORS: Record<string, { dark: string; light: string }> = {
    'JavaScript': { dark: '#f7df1e', light: '#b8960f' },
    'Gin': { dark: '#008ecf', light: '#008ecf' },
    'HTMX': { dark: '#3366cc', light: '#3366cc' },
    'Axios': { dark: '#7a4fff', light: '#5a29e4' },
    'LaTeX': { dark: '#008080', light: '#008080' },
    'Anime.js': { dark: '#f7fafc', light: '#1a202c' },
    'JSON Web Tokens': { dark: '#f7fafc', light: '#1a202c' },
    'React': { dark: '#61dafb', light: '#0099cc' },
    'Bootstrap': { dark: '#7952b3', light: '#7952b3' },
  };

  function applyFallbackColors() {
    const isDark = !document.documentElement.getAttribute('data-theme') ||
                    document.documentElement.getAttribute('data-theme') !== 'light';
    document.querySelectorAll('.project-icon__single[data-fallback="true"]').forEach((el) => {
      const parent = el.closest('.project-icon');
      const tech = parent?.getAttribute('title');
      if (tech && THEME_COLORS[tech]) {
        const svg = el.querySelector('svg');
        if (svg) {
          svg.style.color = isDark ? THEME_COLORS[tech].dark : THEME_COLORS[tech].light;
        }
      }
    });
  }

  function init() {
    applyFallbackColors();
    const observer = new MutationObserver(() => applyFallbackColors());
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
