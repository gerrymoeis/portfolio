---
/**
 * ProjectGrid - Grid layout for project cards
 * Alternating 3-column → 2-column → 3-column pattern on desktop
 * Creates masonry-like visual with uniform card sizes
 */

import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// Get all projects, sorted by priority (in-progress, higher first) then by date (newest first)
const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.status === 'in-progress' && b.data.status !== 'in-progress') return -1;
  if (a.data.status !== 'in-progress' && b.data.status === 'in-progress') return 1;
  if (a.data.status === 'in-progress' && b.data.status === 'in-progress') {
    return (b.data.priority || 0) - (a.data.priority || 0);
  }
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<div class="project-grid" role="list" aria-label="Projects list">
  {sortedProjects.map((project) => (
    <ProjectCard
      title={project.data.title}
      summary={project.data.summary}
      year={project.data.year}
      status={project.data.status}
      category={project.data.category}
      craft={project.data.craft}
      techStack={project.data.techStack}
      thumbnail={project.data.thumbnail}
      links={project.data.links}
      linkTitles={project.data.linkTitles}
    />
  ))}
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr; /* Default: single column */
    gap: var(--space-8);
    width: 100%;
    margin: 0;
    padding: var(--space-8) 0;
  }

  /* Tablet: 2 columns */
  @media (min-width: 769px) and (max-width: 899px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
      padding: var(--space-6) 0;
    }
  }

  /* Desktop: 3 cards horizontally aligned */
  @media (min-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
      padding: var(--space-8) 0;
    }
  }

  /* Mobile: Single column (vertical stack) */
  @media (max-width: 768px) {
    .project-grid {
      gap: var(--space-8);
      padding: var(--space-6) 0;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      gap: var(--space-6);
      padding: var(--space-6) 0;
    }
  }
</style>

<script>
  /**
   * Project filtering functionality
   * Listens for filter changes and shows/hides cards accordingly
   */
  
  function initProjectFilter() {
    const grid = document.querySelector('.project-grid');
    if (!grid) return;

    // Listen for custom filter event
    document.addEventListener('project-filter-change', ((event: CustomEvent) => {
      const category = event.detail.category;
      const cards = grid.querySelectorAll('.project-card');

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category') || '';
        const categories = cardCategory.split(' ').filter(Boolean);
        
        if (category === 'all' || categories.includes(category)) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    }) as EventListener);
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilter);
  } else {
    initProjectFilter();
  }
</script>
