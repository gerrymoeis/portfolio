---
/**
 * ProjectCard - Individual project card for grid display
 * Matches BlogCard styling for consistency
 * 
 * Props:
 * - title: Bilingual project title {en, id}
 * - summary: Bilingual project summary {en, id}
 * - year: Project year
 * - status: Project status
 * - category: Project category
 * - techStack: Array of technologies used
 * - thumbnail: Path to thumbnail image
 * - links: Optional links object (github, live, demo)
 */

import { 
  siAstro, siTypescript, siJavascript, siReact, siVuedotjs,
  siNodedotjs, siPython, siTailwindcss, siHtml5, siVite,
  siAnimedotjs, siLatex
} from 'simple-icons';

interface Props {
  title: { en: string; id: string };
  summary: { en: string; id: string };
  year: number;
  status: 'completed' | 'in-progress' | 'experimental' | 'archived';
  category: 'web' | 'backend' | 'data-mining' | 'all';
  techStack: string[];
  thumbnail: string;
  links?: {
    github?: string;
    live?: string;
    demo?: string;
  };
}

const { title, summary, year, status, category, techStack, thumbnail, links } = Astro.props;

// Format status for display with bilingual support
const statusDisplay = {
  'completed': { en: 'Completed', id: 'Selesai' },
  'in-progress': { en: 'In Progress', id: 'Dalam Proses' },
  'experimental': { en: 'Experimental', id: 'Eksperimental' },
  'archived': { en: 'Archived', id: 'Diarsipkan' }
};

// Icon registry - only icons actually used in projects
const iconRegistry: Record<string, any> = {
  'Astro': siAstro,
  'TypeScript': siTypescript,
  'JavaScript': siJavascript,
  'React': siReact,
  'Vue': siVuedotjs,
  'Node.js': siNodedotjs,
  'Python': siPython,
  'Tailwind CSS': siTailwindcss,
  'HTML': siHtml5,
  'Vite': siVite,
  'Anime.js': siAnimedotjs,
  'LaTeX': siLatex,
};

// Get icon data for a tech stack item
function getTechIcon(techName: string) {
  return iconRegistry[techName] || null;
}
---

<article class="project-card" data-category={category} role="listitem">
  <div class="project-card__content">
    <!-- Thumbnail - Larger 16:9 -->
    <div class="project-card__thumbnail">
      <img 
        src={thumbnail} 
        alt={`${title.en} thumbnail`}
        loading="lazy"
        class="project-card__image"
      />
    </div>
    
    <!-- Title - Center aligned for emphasis -->
    <h2 class="project-card__title" data-bilingual>
      <span data-lang="en">{title.en}</span>
      <span data-lang="id">{title.id}</span>
    </h2>
    
    <!-- Meta - Left aligned -->
    <div class="project-card__meta">
      <span class="project-card__year">{year}</span>
      <span class="project-card__status" data-status={status} data-bilingual>
        <span data-lang="en">{statusDisplay[status].en}</span>
        <span data-lang="id">{statusDisplay[status].id}</span>
      </span>
    </div>
    
    <!-- Tech Stack - Left aligned with SVG icons -->
    <div class="project-card__tech">
      {techStack.map(tech => {
        const icon = getTechIcon(tech);
        return icon ? (
          <div 
            class="project-card__tech-icon" 
            title={tech}
            data-tech-color={icon.hex}
          >
            <svg 
              role="img" 
              viewBox="0 0 24 24" 
              xmlns="http://www.w3.org/2000/svg"
              aria-label={tech}
            >
              <path d={icon.path} fill="currentColor" />
            </svg>
          </div>
        ) : (
          <span class="project-card__tech-item" title={tech}>
            {tech}
          </span>
        );
      })}
    </div>
    
    <!-- Links - Left aligned -->
    {links && (
      <div class="project-card__links">
        {links.github && (
          <a 
            href={links.github} 
            class="project-card__link" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={`View ${title.en} on GitHub (opens in new tab)`}
          >
            <i class="fab fa-github"></i>
            <span data-bilingual>
              <span data-lang="en">GitHub</span>
              <span data-lang="id">GitHub</span>
            </span>
          </a>
        )}
        {links.live && (
          <a 
            href={links.live} 
            class="project-card__link" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={`Visit ${title.en} live site (opens in new tab)`}
          >
            <i class="fas fa-external-link-alt"></i>
            <span data-bilingual>
              <span data-lang="en">Live</span>
              <span data-lang="id">Live</span>
            </span>
          </a>
        )}
        {links.demo && (
          <a 
            href={links.demo} 
            class="project-card__link" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={`View ${title.en} demo (opens in new tab)`}
          >
            <i class="fas fa-play-circle"></i>
            <span data-bilingual>
              <span data-lang="en">Demo</span>
              <span data-lang="id">Demo</span>
            </span>
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-elevated);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    box-shadow: 
      0 4px 12px var(--color-shadow-medium),
      0 2px 4px var(--color-shadow-light);
    transition: 
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
    position: relative;
    overflow: hidden;
    min-height: 420px; /* Minimum height for landscape */
    height: auto; /* Allow natural growth */
    display: flex;
    flex-direction: column;
  }

  /* Subtle grain texture overlay */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/textures/grain.png');
    opacity: 0.03;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .project-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }
  
  /* Dark theme hover - golden yellow glow */
  :global(html:not([data-theme="light"])) .project-card {
    border-color: rgba(246, 224, 94, 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 2px 8px rgba(0, 0, 0, 0.3);
  }
  
  :global(html:not([data-theme="light"])) .project-card:hover {
    border-color: rgba(246, 224, 94, 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(246, 224, 94, 0.3),
      0 0 15px rgba(246, 224, 94, 0.2);
  }
  
  /* Light theme hover - red-orange glow */
  :global([data-theme="light"]) .project-card {
    border-color: rgba(255, 85, 0, 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  :global([data-theme="light"]) .project-card:hover {
    border-color: rgba(255, 85, 0, 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 85, 0, 0.25),
      0 0 15px rgba(255, 85, 0, 0.15);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    position: relative;
    z-index: 1;
    height: 100%;
  }

  /* Thumbnail - Larger (240px = ~63% of 380px card) */
  .project-card__thumbnail {
    width: 100%;
    height: 240px;
    overflow: hidden;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    flex-shrink: 0;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.05);
  }

  /* Title - Center aligned for emphasis */
  .project-card__title {
    font-family: var(--font-primary);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
    text-align: center;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card:hover .project-card__title {
    color: var(--color-accent-primary);
  }
  
  /* Dark theme title hover - golden glow */
  :global(html:not([data-theme="light"])) .project-card:hover .project-card__title {
    color: #f6e05e;
    text-shadow: 
      0 0 20px rgba(246, 224, 94, 0.6),
      0 0 10px rgba(246, 224, 94, 0.4);
  }
  
  /* Light theme title hover - red-orange glow */
  :global([data-theme="light"]) .project-card:hover .project-card__title {
    color: #ff5500;
    text-shadow: 
      0 0 20px rgba(255, 85, 0, 0.5),
      0 0 10px rgba(255, 85, 0, 0.3);
  }
  
  /* Hide inactive language for title */
  .project-card__title span[data-lang] {
    display: none;
  }
  
  /* Show active language for title */
  :global(html[lang="en"]) .project-card__title span[data-lang="en"],
  :global(html[lang="id"]) .project-card__title span[data-lang="id"] {
    display: inline;
  }

  /* Meta - Left aligned */
  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .project-card__year {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
  }

  .project-card__status {
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-social-hover-bg-subtle);
    border: 1px solid var(--color-border-medium);
  }

  .project-card__status[data-status="completed"] {
    color: var(--color-accent-primary);
    border-color: var(--color-border-accent);
  }

  .project-card__status[data-status="in-progress"] {
    color: var(--color-accent-secondary);
    border-color: var(--color-border-accent);
  }

  .project-card__status[data-status="experimental"] {
    color: var(--color-text-secondary);
    border-color: var(--color-border-medium);
  }

  .project-card__status[data-status="archived"] {
    color: var(--color-text-tertiary);
    border-color: var(--color-border-light);
  }
  
  /* Hide inactive language */
  .project-card__status span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .project-card__status span[data-lang="en"],
  :global(html[lang="id"]) .project-card__status span[data-lang="id"] {
    display: inline;
  }

  /* Tech Stack - Left aligned with SVG icons */
  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    align-items: center;
  }

  .project-card__tech-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: help;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card__tech-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Apply moderate glow effect using drop-shadow on SVG shape */
  .project-card__tech-icon svg {
    filter: 
      drop-shadow(0 0 4px currentColor)
      drop-shadow(0 0 8px currentColor)
      drop-shadow(0 0 2px currentColor);
  }

  .project-card__tech-icon:hover svg {
    filter: 
      drop-shadow(0 0 6px currentColor)
      drop-shadow(0 0 12px currentColor)
      drop-shadow(0 0 3px currentColor);
    transform: scale(1.1);
  }

  /* Fallback text tags for icons not found */
  .project-card__tech-item {
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background-color: var(--color-social-hover-bg-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-medium);
  }

  /* Links - Left aligned */
  .project-card__links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--color-accent-primary);
    text-decoration: none;
    border: 1px solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card__link:hover {
    background: var(--color-accent-primary);
    color: var(--bg-elevated);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .project-card__link i {
    font-size: var(--text-sm);
  }
  
  /* Hide inactive language */
  .project-card__link span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .project-card__link span[data-lang="en"],
  :global(html[lang="id"]) .project-card__link span[data-lang="id"] {
    display: inline;
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__image,
    .project-card__title,
    .project-card__link {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }

    .project-card:hover .project-card__image {
      transform: none;
    }
  }
  
  /* Mobile: Vertical layout fallback */
  @media (max-width: 768px) {
    .project-card {
      height: auto; /* Allow natural height on mobile */
    }
    
    .project-card__content {
      padding: var(--space-6);
    }
    
    .project-card__thumbnail {
      height: 200px; /* Smaller on mobile */
      margin-bottom: var(--space-4);
    }
    
    .project-card__title {
      text-align: left; /* Left align on mobile */
      margin-bottom: var(--space-3);
    }
  }
</style>

<script>
  /**
   * Apply dynamic colors to tech stack icons from simple-icons
   */
  function applyTechIconColors() {
    const icons = document.querySelectorAll('.project-card__tech-icon');
    
    icons.forEach((icon) => {
      const color = icon.getAttribute('data-tech-color');
      if (color) {
        const svg = icon.querySelector('svg');
        if (svg) {
          svg.style.color = `#${color}`;
        }
      }
    });
  }

  // Apply colors on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyTechIconColors);
  } else {
    applyTechIconColors();
  }
</script>
