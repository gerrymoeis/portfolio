---
import ProjectIcon from './ProjectIcon.astro';
import CraftBadge from '../ui/CraftBadge.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
import '../../styles/project-status.css';
import { statusDisplay, linkKeys, linkLabel, linkIcon } from '../../config/projectConfig';
import type { ProjectStatus } from '../../config/projectConfig';
import type { BilingualText, ProjectLinks, ProjectLinkTitles } from '../../types';

interface Props {
  title: BilingualText;
  summary: BilingualText;
  year: number;
  status: ProjectStatus;
  category: string | string[];
  craft?: 'ai' | 'hand-crafted';
  techStack: string[];
  thumbnail: string;
  links?: ProjectLinks;
  linkTitles?: ProjectLinkTitles;
}

const { title, year, status, category, craft, techStack, thumbnail, links, linkTitles } = Astro.props;

const categories = Array.isArray(category) ? category : [category];
const categoriesAttr = categories.join(' ');
---

<article class="project-card" data-category={categoriesAttr} role="listitem">
  {craft && <CraftBadge craft={craft} />}
  <div class="project-card__content">
    <div class="project-card__thumbnail">
      <OptimizedImage 
        src={thumbnail}
        alt={`${title.en} thumbnail`}
        width={800}
        height={450}
        class="project-card__image"
      />
    </div>
    
    <h2 class="project-card__title" data-bilingual>
      <span data-lang="en">{title.en}</span>
      <span data-lang="id">{title.id}</span>
    </h2>
    
    <div class="project-card__meta">
      <span class="project-card__year">{year}</span>
      <span class="project-card__status" data-status={status} data-bilingual>
        <span data-lang="en">{statusDisplay[status].en}</span>
        <span data-lang="id">{statusDisplay[status].id}</span>
      </span>
    </div>
    
    <div class="project-card__tech">
      {techStack.map(tech => (
        <div class="project-card__tech-icon">
          <ProjectIcon name={tech} />
          <span class="tech-tooltip">{tech}</span>
        </div>
      ))}
    </div>
    
    {links && (
      <div class="project-card__links">
        {linkKeys.map(key => {
          const url = links[key];
          if (!url) return null;
          const label = linkLabel(key, linkTitles);
          return (
            <a 
              href={url} 
              class="project-card__link" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label={`${label} - ${title.en}`}
            >
              <i class={linkIcon(key, linkTitles)}></i>
              <span data-bilingual>
                <span data-lang="en">{label}</span>
                <span data-lang="id">{label}</span>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-elevated);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    box-shadow: 
      0 4px 12px var(--color-shadow-medium),
      0 2px 4px var(--color-shadow-light);
    transition: 
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-medium) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
    position: relative;
    overflow: hidden;
    height: auto;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }
  
  :global(html:not([data-theme="light"])) .project-card {
    border-color: rgba(var(--accent-rgb), 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.4),
      0 2px 8px rgba(0, 0, 0, 0.3);
  }
  
  :global(html:not([data-theme="light"])) .project-card:hover {
    border-color: rgba(var(--accent-rgb), 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.5),
      0 0 30px rgba(var(--accent-rgb), 0.3),
      0 0 15px rgba(var(--accent-rgb), 0.2);
  }
  
  :global([data-theme="light"]) .project-card {
    border-color: rgba(var(--accent-rgb), 0.4);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  :global([data-theme="light"]) .project-card:hover {
    border-color: rgba(var(--accent-rgb), 0.8);
    box-shadow: 
      0 8px 24px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(var(--accent-rgb), 0.25),
      0 0 15px rgba(var(--accent-rgb), 0.15);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    position: relative;
    z-index: 1;
    height: 100%;
  }

  .project-card__thumbnail {
    overflow: hidden;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .project-card__image {
    width: 100%;
    display: block;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.05);
  }

  .project-card__title {
    font-family: var(--font-primary);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    text-align: center;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card:hover .project-card__title {
    color: var(--color-accent-primary);
  }
  
  :global(html:not([data-theme="light"])) .project-card:hover .project-card__title {
    color: var(--color-accent-primary);
    text-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.6),
      0 0 10px rgba(var(--accent-rgb), 0.4);
  }
  
  :global([data-theme="light"]) .project-card:hover .project-card__title {
    color: var(--color-accent-primary);
    text-shadow: 
      0 0 20px rgba(var(--accent-rgb), 0.5),
      0 0 10px rgba(var(--accent-rgb), 0.3);
  }
  


  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .project-card__year {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-tertiary);
  }

  .project-card__status {
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid;
    transition: all var(--duration-fast) var(--ease-out);
  }



  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .project-card__tech-icon {
    position: relative;
  }

  .tech-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-text-primary);
    color: var(--bg-elevated);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-family: var(--font-primary);
    white-space: nowrap;
    z-index: var(--layer-tooltip, 40);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .project-card__tech-icon:hover .tech-tooltip,
  .project-card__tech-icon:focus-within .tech-tooltip,
  .project-card__tech-icon .tech-tooltip.visible {
    opacity: 1;
  }

  .project-card__links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: transparent;
    color: var(--color-accent-primary);
    text-decoration: none;
    border: 1px solid var(--color-accent-primary);
    border-radius: var(--radius-sm);
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .project-card__link:hover {
    background: var(--color-accent-primary);
    color: var(--bg-elevated);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .project-card__link i {
    font-size: var(--text-sm);
  }
  
  
  @media (max-width: 768px) {
    .project-card { height: auto; }
    .project-card__content { padding: var(--space-6); }
    .project-card__title { text-align: left; }
  }
</style>

<script>
  import { initTechTooltips } from '../../scripts/techTooltips';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initTechTooltips('.project-card__tech-icon'));
  } else {
    initTechTooltips('.project-card__tech-icon');
  }
</script>
