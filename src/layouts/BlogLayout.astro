---
/**
 * BlogLayout - Layout for individual blog post pages
 * Extends BaseLayout with blog-specific metadata and structure
 * 
 * Props:
 * - title: Blog post title (bilingual object)
 * - description: Blog post summary for SEO (bilingual object)
 * - date: Publication date (required)
 * - tags: Optional array of tags
 * - slug: Blog post slug for canonical URL (required)
 */

import Navigation from '../components/ui/Navigation.astro';
import Footer from '../components/ui/Footer.astro';
import ViewCounter from '../components/blogs/ViewCounter.astro';

// Import CSS files so Astro can process them
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/motion.css';

interface Props {
  title: { en: string; id: string };
  description: { en: string; id: string };
  date: Date;
  tags?: string[];
  slug: string;
}

const { title, description, date, tags, slug } = Astro.props;

// Format date for display
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date);

// Get canonical URL
const canonicalURL = new URL(`/blogs/${slug}`, Astro.site || Astro.url.origin);

// Open Graph image (using a default for now)
const ogImage = new URL('/favicon.svg', Astro.site || Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title.en}</title>
    <meta name="title" content={title.en} />
    <meta name="description" content={description.en} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title.en} />
    <meta property="og:description" content={description.en} />
    <meta property="og:image" content={ogImage.href} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title.en} />
    <meta property="twitter:description" content={description.en} />
    <meta property="twitter:image" content={ogImage.href} />
    
    <!-- Article Meta -->
    <meta property="article:published_time" content={date.toISOString()} />
    {tags && tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Fonts - Inter (Single font for entire website) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <script src="https://kit.fontawesome.com/3f7347f781.js" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="page-layout depth-mid">
      <header class="page-nav depth-near" role="banner">
        <Navigation />
      </header>
      
      <main class="blog-detail" role="main">
        <!-- 
          FUTURE DEVELOPMENT: Sidebar for Related Posts & Recommendations
          
          When we have 3+ blog posts, implement sidebar layout:
          
          Desktop Layout:
          - Container: max-width 1400px
          - Main content: ~900px (65%) 
          - Sidebar: 350px (25%)
          - Gap: 50px between content and sidebar
          
          Sidebar Widgets (Priority Order):
          1. Related Posts (based on tags) - 3-5 posts
          2. Table of Contents (auto-generated from H2/H3)
          3. Popular Posts (based on view count)
          4. Tags/Categories filter
          
          Mobile Layout:
          - Single column (stack vertically)
          - Sidebar content moves to bottom
          - Show only top 2-3 widgets
          
          Implementation:
          - Change .blog-detail to grid layout
          - Create BlogSidebar.astro component
          - Implement related posts algorithm
          - Add sticky sidebar behavior (desktop only)
          
          See: docs_and_backup/docs/blog-sidebar-recommendations-plan.md
        -->
        <article class="blog-article">
          <header class="blog-header">
            <h1 class="blog-title" data-bilingual>
              <span data-lang="en">{title.en}</span>
              <span data-lang="id">{title.id}</span>
            </h1>
            
            <div class="blog-meta">
              <time datetime={date.toISOString()} class="blog-date">
                {formattedDate}
              </time>
              
              <!-- View Counter -->
              <ViewCounter slug={slug} />
              
              {tags && tags.length > 0 && (
                <div class="blog-tags" role="list" aria-label="Article tags">
                  {tags.map(tag => (
                    <span class="blog-tag" role="listitem">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            
            <p class="blog-summary" data-bilingual>
              <span data-lang="en">{description.en}</span>
              <span data-lang="id">{description.id}</span>
            </p>
          </header>
          
          <div class="blog-content">
            <slot />
          </div>
        </article>
      </main>

      <Footer currentPath={Astro.url.pathname} />
    </div>
    
    <!-- Load view counter client script -->
    <script>
      import { initViewCounters } from '../components/blogs/ViewCounterClient';
      initViewCounters();
    </script>
  </body>
</html>

<style>
  .page-layout {
    min-height: 100vh;
    background: 
      radial-gradient(
        ellipse at center top,
        var(--color-bg-light) 0%,
        var(--color-bg-mid) 30%,
        var(--color-bg-dark) 70%,
        var(--color-bg-deep) 100%
      ),
      /* Atmospheric texture overlay */
      radial-gradient(circle at 30% 20%, rgba(246, 224, 94, 0.02) 0%, transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(139, 149, 109, 0.015) 0%, transparent 50%);
  }

  .page-nav {
    position: sticky;
    top: 0;
    z-index: var(--layer-navigation);
    background: var(--color-surface-elevated);
    backdrop-filter: blur(12px);
    border-bottom: 2px solid var(--color-border-accent);
    padding: var(--space-4) var(--space-6);
    box-shadow: var(--panel-shadow-base);
  }

  .page-nav :global(.navigation) {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-detail {
    max-width: 1100px; /* Increased from 900px for even wider layout on desktop */
    margin: 0 auto;
    padding: var(--space-16) var(--space-10);
    
    /* 
      FUTURE: When sidebar is implemented, change to:
      max-width: 1400px;
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: var(--space-10);
    */
  }
  
  .blog-article {
    animation: fadeIn var(--duration-medium) var(--ease-out);
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(var(--space-4));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .blog-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-medium);
  }
  
  .blog-title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }
  
  /* Hide inactive language */
  .blog-title span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .blog-title span[data-lang="en"],
  :global(html[lang="id"]) .blog-title span[data-lang="id"] {
    display: inline;
  }
  
  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
  }
  
  .blog-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }
  
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .blog-tag {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    background: var(--color-surface-base);
    padding: var(--space-1) var(--space-3);
    border-radius: 4px;
    border: 1px solid var(--color-border-medium);
  }
  
  .blog-summary {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    font-style: italic;
  }
  
  /* Hide inactive language */
  .blog-summary span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .blog-summary span[data-lang="en"],
  :global(html[lang="id"]) .blog-summary span[data-lang="id"] {
    display: inline;
  }
  
  .blog-content {
    font-size: 1.0625rem; /* 17px - optimal for reading */
    line-height: 1.6; /* Optimal line height for body text */
    color: var(--color-text-primary);
  }
  
  /* Bilingual content support */
  .blog-content :global([data-bilingual] [data-lang]) {
    display: none;
  }
  
  :global(html[lang="en"]) .blog-content :global([data-bilingual] [data-lang="en"]),
  :global(html[lang="id"]) .blog-content :global([data-bilingual] [data-lang="id"]) {
    display: block;
  }
  
  /* Markdown content styling */
  .blog-content :global(h1),
  .blog-content :global(h2),
  .blog-content :global(h3),
  .blog-content :global(h4),
  .blog-content :global(h5),
  .blog-content :global(h6) {
    font-family: var(--font-primary);
    font-weight: var(--weight-bold);
    line-height: 1.3; /* Tighter for headings */
    color: var(--color-text-primary);
    margin-top: 2.5rem; /* Reduced from var(--space-10) */
    margin-bottom: 1rem; /* Reduced from var(--space-4) */
  }
  
  .blog-content :global(h1) {
    font-size: 2rem; /* 32px */
    margin-top: 3rem;
  }
  
  .blog-content :global(h2) {
    font-size: 1.625rem; /* 26px */
    margin-top: 2.5rem;
  }
  
  .blog-content :global(h3) {
    font-size: 1.375rem; /* 22px */
    margin-top: 2rem;
  }
  
  .blog-content :global(p) {
    margin-bottom: 1.25rem; /* Reduced from var(--space-6) for better flow */
  }
  
  .blog-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-border-medium);
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }
  
  .blog-content :global(a:hover) {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }
  
  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-bottom: 1.25rem; /* Consistent with paragraph spacing */
    padding-left: 1.75rem; /* Reduced from var(--space-8) */
    line-height: 1.7; /* Slightly more spacing for lists */
  }
  
  .blog-content :global(li) {
    margin-bottom: 0.5rem; /* Reduced from var(--space-3) */
  }
  
  .blog-content :global(li:last-child) {
    margin-bottom: 0;
  }
  
  .blog-content :global(code) {
    font-family: var(--font-primary);
    font-size: 0.9375em; /* 15px when base is 17px */
    background: var(--color-surface-base);
    letter-spacing: 0.02em;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    border: 1px solid var(--color-border-medium);
  }
  
  .blog-content :global(pre) {
    background: var(--color-surface-base);
    padding: 1.25rem;
    border-radius: 6px;
    border: 1px solid var(--color-border-medium);
    overflow-x: auto;
    margin-bottom: 1.5rem;
    line-height: 1.5; /* Tighter for code blocks */
  }
  
  .blog-content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }
  
  .blog-content :global(blockquote) {
    border-left: 3px solid var(--color-accent-primary);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 1.0625rem; /* Same as body */
  }
  
  .blog-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 2rem 0;
  }
  
  .blog-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-medium);
    margin: 2.5rem 0;
  }
  
  /* Responsive adjustments */
  @media (max-width: var(--breakpoint-lg)) {
    .blog-detail {
      max-width: 100%;
      padding: var(--space-8) var(--space-6);
    }
    
    .blog-title {
      font-size: var(--text-3xl);
    }
    
    .blog-summary {
      font-size: var(--text-base);
    }
    
    .blog-content {
      font-size: 1rem; /* 16px on mobile */
    }
    
    .blog-content :global(h1) {
      font-size: 1.75rem; /* 28px */
    }
    
    .blog-content :global(h2) {
      font-size: 1.5rem; /* 24px */
    }
    
    .blog-content :global(h3) {
      font-size: 1.25rem; /* 20px */
    }
  }
  
  @media (max-width: var(--breakpoint-sm)) {
    .blog-detail {
      padding: var(--space-6) var(--space-4);
    }
    
    .blog-content {
      font-size: 1rem; /* 16px */
    }
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .blog-article {
      animation: none;
    }
  }
</style>
