---
import BaseLayout from '../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../components/ui/SemiCylindricalNav.astro';
import PageBackgroundGradient from '../components/ui/PageBackgroundGradient.astro';
import HeroCompact from '../components/home/HeroCompact.astro';
import FeaturedProjectsSection from '../components/home/FeaturedProjectsSection.astro';
import BlogPreviewSection from '../components/home/BlogPreviewSection.astro';
import { homeConfig } from '../config/home';

const navLinks = homeConfig.navigation;
---

<BaseLayout
  title="Gerry Moeis | Web Developer & Tech Enthusiast"
  description="Computer Science student at State University of Surabaya passionate about web development, modern technologies, and building meaningful digital solutions."
  ogType="website"
>
  <SemiCylindricalNav links={navLinks} currentPath="/" />

  <div class="page-layout depth-mid home-page">
    <PageBackgroundGradient />
    <main role="main" class="home-main">
      <section class="home-section home-section--hero">
        <HeroCompact />
      </section>

      <section class="home-section home-section--featured">
        <FeaturedProjectsSection />
      </section>

      <section class="home-section home-section--blog">
        <BlogPreviewSection />
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-layout {
    position: relative;
    min-height: 100vh;
    background: var(--bg-elevated);
  }

  .page-layout > :global(*:not(.page-gradient)) {
    position: relative;
    z-index: 1;
  }

  .home-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .home-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .home-section--hero {
    flex: 1;
    padding-top: calc(var(--space-32) + var(--space-8));
    padding-bottom: var(--space-8);
  }

  .home-section--featured {
    flex: 2;
    padding: var(--space-8) 0;
  }

  .home-section--blog {
    flex: 1;
    padding-bottom: var(--space-16);
  }

  @media (max-width: 768px) {
    .home-section--hero {
      padding-top: calc(var(--space-20) + var(--space-8));
      padding-bottom: var(--space-4);
    }

    .home-section--featured {
      padding: var(--space-4) 0;
    }

    .home-section--blog {
      padding-bottom: var(--space-12);
    }
  }

  @media (max-width: 480px) {
    .home-section--hero {
      padding-top: calc(var(--space-16) + var(--space-8));
      padding-bottom: var(--space-2);
    }
  }
</style>
