---
/**
 * Home Page - Redesigned Layout
 * Single-screen layout with semi-cylindrical nav, 3-block grid, and particle effects
 * Minimalist aesthetic with subtle fantasy influences
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/ui/Panel.astro';
import SemiCylindricalNav from '../components/ui/SemiCylindricalNav.astro';
import Hero from '../components/home/Hero.astro';
import SocialPanel from '../components/home/SocialPanel.astro';
import SoundCloudPlaylistCarousel from '../components/home/SoundCloudPlaylistCarousel.astro';
import AudioVisualizer from '../components/home/AudioVisualizer.astro';
import AudioVisualizerControls from '../components/home/AudioVisualizerControls.astro';
import { homeConfig } from '../config/home';

const { hero, social, navigation } = homeConfig;

// SoundCloud playlists with universal amber color
const soundCloudPlaylists = [
  {
    id: 'octopath-1',
    title: 'Octopath Traveler OST',
    artist: 'RoxlinkZ 🌀',
    embedUrl: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A561457083&color=%23ffa600&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true'
  },
  {
    id: 'octopath-2',
    title: 'Octopath Traveler 2 Soundtrack',
    artist: 'InfiniteShadow',
    embedUrl: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A1925643635&color=%23ffa600&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true'
  },
  {
    id: 'octopath-0',
    title: 'OCTOPATH TRAVELER 0 OST',
    artist: 'RoxlinkZ 🌀',
    embedUrl: 'https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A2155948367&color=%23ffa600&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true'
  }
];
---

<BaseLayout 
  title="Gerry Moeis | Web Developer & Tech Enthusiast" 
  description="Computer Science student at State University of Surabaya passionate about web development, modern technologies, and building meaningful digital solutions."
  noScroll={false}
  ogType="website"
>
  <!-- Semi-cylindrical navigation at top -->
  <SemiCylindricalNav links={navigation} currentPath="/" />

  <!-- Main content with radial gradient background -->
  <main class="home page-background-radial depth-mid" role="main">
    <!-- Row 1: One long horizontal block (Hero) -->
    <section class="home__hero-block" aria-label="Introduction">
      <Panel variant="elevated" depth="near" glow={true} class="content-block content-block--hero">
        <Hero 
          title={hero.title}
          subtitle={hero.subtitle}
          description={hero.description}
        />
      </Panel>
    </section>

    <!-- Row 2: Two blocks - Social (left, smaller) + Music (right, larger) -->
    <div class="home__bottom-row">
      <aside class="home__social-block" aria-label="Social media links">
        <Panel variant="atmospheric" depth="mid" class="content-block content-block--social">
          <SocialPanel social={social} />
        </Panel>
      </aside>

      <aside class="home__music-block" aria-label="SoundCloud music player">
        <Panel variant="atmospheric" depth="mid" class="content-block content-block--music">
          <SoundCloudPlaylistCarousel playlists={soundCloudPlaylists} />
        </Panel>
      </aside>
    </div>
  </main>

  <!-- Audio Visualizer BEFORE main content in DOM for proper stacking -->
  <AudioVisualizer height={180} />
  
  <!-- Audio Visualizer Controls -->
  <AudioVisualizerControls />
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: var(--space-32) var(--space-6) var(--space-32);
    gap: calc(var(--space-32) / 3);
  }

  .home__hero-block,
  .home__bottom-row {
    width: 100%;
    max-width: var(--max-width);
  }

  .home__bottom-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .home__music-block {
    min-height: 400px;
  }

  :global(.content-block--hero) {
    text-align: center;
    padding: var(--panel-padding);
  }

  :global(.content-block--social),
  :global(.content-block--music) {
    padding: var(--panel-padding);
  }

  @media (max-width: 480px) {
    .home {
      padding: var(--space-16) var(--space-4) var(--space-16);
      gap: calc(var(--space-16) / 3);
    }
  }

  @media (min-width: 901px) {
    .home {
      padding: var(--space-32) var(--space-8) var(--space-32);
    }
    
    .home__bottom-row {
      flex-direction: row;
      gap: var(--space-12);
    }
    
    .home__social-block {
      flex: 1;
      min-width: 300px;
    }
    
    .home__music-block {
      flex: 2;
      min-width: 400px;
    }
  }
</style>
