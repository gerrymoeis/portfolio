---
import BaseLayout from '../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../components/ui/SemiCylindricalNav.astro';
import PageBackgroundGradient from '../components/ui/PageBackgroundGradient.astro';
import Panel from '../components/ui/Panel.astro';
import Icon from '../components/ui/Icon.astro';
import HeroCompact from '../components/home/HeroCompact.astro';
import FeaturedProjectsSection from '../components/home/FeaturedProjectsSection.astro';
import { homeConfig } from '../config/home';

const navLinks = homeConfig.navigation;

const socialLinks = [
  { name: "GitHub", url: "https://github.com/gerrymoeis", icon: "github" },
  { name: "Gmail", url: "mailto:gerrymoeis@gmail.com", icon: "email" },
  { name: "YouTube", url: "https://www.youtube.com/@gerrymoeis", icon: "youtube" },
];
---

<BaseLayout
  title="Gerry Moeis | Web Developer & Tech Enthusiast"
  description="Computer Science student at State University of Surabaya passionate about web development, modern technologies, and building meaningful digital solutions."
  ogType="website"
>
  <SemiCylindricalNav links={navLinks} currentPath="/" />

  <div class="page-layout depth-mid">
    <PageBackgroundGradient />
    <main role="main" class="home-main">
      <Panel variant="elevated" glow={true} class="home-panel">
        <div class="home-panel__top">
          <div class="home-panel__hero">
            <HeroCompact />
          </div>
          <div class="home-panel__socials">
            <p class="home-panel__socials-heading" data-bilingual>
              <span data-lang="en">Find me on</span>
              <span data-lang="id">Temui saya di</span>
            </p>
            {socialLinks.map((link) => (
              <a
                href={link.url}
                class="home-panel__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${link.name}`}
              >
                <Icon name={link.icon} size="lg" />
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>

        <hr class="home-panel__divider" />

        <a href="/projects" class="home-panel__cta" data-bilingual>
          <span data-lang="en">See all projects →</span>
          <span data-lang="id">Lihat semua proyek →</span>
        </a>

        <FeaturedProjectsSection />
      </Panel>
    </main>
  </div>
</BaseLayout>

<style>
  .page-layout {
    position: relative;
    min-height: 100dvh;
    background: var(--bg-elevated);
  }

  .page-layout > :global(*:not(.page-gradient)) {
    position: relative;
    z-index: 1;
  }

  .home-main {
    display: flex;
    justify-content: center;
    width: 80%;
    max-width: 68rem;
    margin: 0 auto;
    padding: var(--space-32) 0 0;
    box-sizing: border-box;
  }

  .home-panel {
    width: 100%;
  }

  .home-panel.panel.panel--elevated {
    padding: var(--space-6);
  }

  .home-panel__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .home-panel__hero {
    min-width: 0;
  }

  .home-panel__socials {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    border-top: 1px solid var(--color-border-medium);
    padding-top: var(--space-3);
  }

  .home-panel__socials-heading {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin: 0;
    font-weight: var(--weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-panel__socials-heading span[data-lang] { display: none; }
  :global(html[lang="en"]) .home-panel__socials-heading span[data-lang="en"],
  :global(html[lang="id"]) .home-panel__socials-heading span[data-lang="id"] { display: inline; }

  .home-panel__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    transition:
      color var(--duration-medium) var(--ease-out),
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
  }

  .home-panel__social-link:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  :global(html:not([data-theme="light"])) .home-panel__social-link:hover {
    box-shadow:
      0 0 20px rgba(246, 224, 94, 0.4),
      0 0 10px rgba(246, 224, 94, 0.2);
  }

  :global([data-theme="light"]) .home-panel__social-link:hover {
    box-shadow:
      0 0 20px rgba(255, 85, 0, 0.3),
      0 0 10px rgba(255, 85, 0, 0.15);
  }

  .home-panel__social-link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .home-panel__social-link i {
    font-size: var(--text-lg);
  }

  .home-panel__divider {
    border: none;
    border-top: 1px solid var(--color-border-medium);
    margin: var(--space-3) 0;
  }

  .home-panel__cta {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-accent-primary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .home-panel__cta:hover {
    transform: translateX(4px);
  }

  .home-panel__cta span[data-lang] { display: none; }
  :global(html[lang="en"]) .home-panel__cta span[data-lang="en"],
  :global(html[lang="id"]) .home-panel__cta span[data-lang="id"] { display: inline; }

  @media (max-width: 767px) {
    .home-main {
      padding: var(--space-16) var(--space-4) var(--space-10);
    }

    .home-panel__top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .home-panel__socials {
      align-items: stretch;
    }

    .home-panel__social-link {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .home-main {
      padding: var(--space-14) var(--space-3) var(--space-10);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-panel__social-link,
    .home-panel__cta {
      transition: none;
    }

    .home-panel__social-link:hover {
      transform: none;
    }

    .home-panel__cta:hover {
      transform: none;
    }
  }
</style>
