---
import BaseLayout from '../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../components/ui/SemiCylindricalNav.astro';
import PageBackgroundGradient from '../components/ui/PageBackgroundGradient.astro';
import Panel from '../components/ui/Panel.astro';
import Icon from '../components/ui/Icon.astro';
import HeroCompact from '../components/home/HeroCompact.astro';
import FeaturedProjectsSection from '../components/home/FeaturedProjectsSection.astro';
import { homeConfig } from '../config/home';

const navLinks = homeConfig.navigation;

const socialLinks = [
  { name: "GitHub", url: "https://github.com/gerrymoeis", icon: "github" },
  { name: "Email", url: "mailto:gerrymoeis@gmail.com", icon: "email" },
];
---

<BaseLayout
  title="Gerry Moeis | Web Developer & Tech Enthusiast"
  description="Computer Science student at State University of Surabaya passionate about web development, modern technologies, and building meaningful digital solutions."
  ogType="website"
>
  <SemiCylindricalNav links={navLinks} currentPath="/" />

  <div class="page-layout depth-mid">
    <PageBackgroundGradient />
    <main role="main" class="home-main">
      <Panel variant="elevated" glow={true} class="home-panel">
        <div class="home-panel__top">
          <div class="home-panel__hero">
            <HeroCompact />
          </div>
          <div class="home-panel__connect">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                class="home-panel__connect-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${link.name}`}
              >
                <Icon name={link.icon} class="home-panel__connect-icon" />
              </a>
            ))}
          </div>
        </div>

        <hr class="home-panel__divider" />

        <a href="/projects" class="home-panel__cta" data-bilingual>
          <span data-lang="en">See all projects →</span>
          <span data-lang="id">Lihat semua proyek →</span>
        </a>

        <FeaturedProjectsSection />
      </Panel>
    </main>
  </div>
</BaseLayout>

<style>
  .page-layout {
    position: relative;
    min-height: 100vh;
    background: var(--bg-elevated);
  }

  .page-layout > :global(*:not(.page-gradient)) {
    position: relative;
    z-index: 1;
  }

  .home-main {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: calc(var(--space-32) + var(--space-8)) var(--space-6) var(--space-16);
    width: 100%;
  }

  .home-panel {
    width: 100%;
    max-width: var(--max-width);
  }

  .home-panel__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .home-panel__hero {
    flex: 2 1 280px;
  }

  .home-panel__connect {
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .home-panel__connect-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color var(--duration-medium) var(--ease-out),
      border-color var(--duration-medium) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-medium) var(--ease-out);
  }

  .home-panel__connect-icon {
    font-size: var(--text-xl);
  }

  .home-panel__connect-link:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  :global(html:not([data-theme="light"])) .home-panel__connect-link:hover {
    box-shadow:
      0 0 20px rgba(246, 224, 94, 0.4),
      0 0 10px rgba(246, 224, 94, 0.2);
  }

  :global([data-theme="light"]) .home-panel__connect-link:hover {
    box-shadow:
      0 0 20px rgba(255, 85, 0, 0.3),
      0 0 10px rgba(255, 85, 0, 0.15);
  }

  .home-panel__connect-link:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .home-panel__divider {
    border: none;
    border-top: 1px solid var(--color-border-medium);
    margin: var(--space-6) 0;
  }

  .home-panel__cta {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-accent-primary);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .home-panel__cta:hover {
    transform: translateX(4px);
  }

  .home-panel__cta span[data-lang] { display: none; }
  :global(html[lang="en"]) .home-panel__cta span[data-lang="en"],
  :global(html[lang="id"]) .home-panel__cta span[data-lang="id"] { display: inline; }

  @media (max-width: 480px) {
    .home-main {
      padding: calc(var(--space-16) + var(--space-8)) var(--space-4) var(--space-12);
    }

    .home-panel__connect {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-panel__connect-link,
    .home-panel__cta {
      transition: none;
    }

    .home-panel__connect-link:hover {
      transform: none;
    }

    .home-panel__cta:hover {
      transform: none;
    }
  }
</style>
