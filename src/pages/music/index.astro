---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import ListingHero from '../../components/ui/ListingHero.astro';
import Panel from '../../components/ui/Panel.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import SoundCloudPlaylistCarousel from '../../components/home/SoundCloudPlaylistCarousel.astro';
import AudioVisualizer from '../../components/home/AudioVisualizer.astro';
import AudioVisualizerControls from '../../components/home/AudioVisualizerControls.astro';
import { homeConfig } from '../../config/home';
import { soundCloudPlaylists } from '../../config/soundcloud';

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title="Music | Gerry Moeis"
  description="Listen to curated SoundCloud playlists with a real-time audio visualizer experience."
  ogImage="/images/projects/personal-portfolio-hero.webp"
  ogType="website"
>
  <SemiCylindricalNav links={homeConfig.navigation} currentPath={currentPath} />

  <div class="page-layout depth-mid music-page">
    <PageBackgroundGradient />
    <main role="main" class="music-main">
      <ListingHero
        title={{ en: 'Music', id: 'Musik' }}
        description={{ en: 'Curated SoundCloud playlists with a real-time audio visualizer. Press start to enhance your listening experience.', id: 'Daftar putar SoundCloud pilihan dengan visualizer audio real-time. Tekan mulai untuk meningkatkan pengalaman mendengarkan.' }}
      />

      <div class="music-content">
        <Panel variant="atmospheric" depth="mid" class="music-player-panel">
          <SoundCloudPlaylistCarousel playlists={soundCloudPlaylists} />
        </Panel>
      </div>
    </main>

    <Footer currentPath={currentPath} />
  </div>

  <AudioVisualizer height={180} />
  <AudioVisualizerControls />
</BaseLayout>

<style>
  .music-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }

  .music-content {
    padding-bottom: 0;
  }

  .music-player-panel {
    min-height: 400px;
  }

  @media (max-width: var(--breakpoint-lg)) {
    .music-main {
      padding: var(--space-16) var(--space-4);
    }
  }
</style>
