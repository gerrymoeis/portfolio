---
/**
 * Blog Listing Page
 * Displays all blog posts in a typography-focused layout with HD-2D aesthetic
 * Sorted by date (newest first) with minimal animation
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import Panel from '../../components/ui/Panel.astro';
import BlogList from '../../components/blogs/BlogList.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import { homeConfig } from '../../config/home';

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Get current path for active state
const currentPath = Astro.url.pathname;
---

<BaseLayout 
  title="Blog | Gerry Moeis"
  description="Thoughts on web development, design, and technology. Explore articles about modern web development, accessibility, and creative coding."
  ogType="website"
>
  <!-- Semi-Cylindrical Navigation (Fixed at top) -->
  <SemiCylindricalNav links={navLinks} currentPath={currentPath} />
  
  <div class="page-layout depth-mid blogs-page">
    <PageBackgroundGradient />
    <main role="main" class="blogs-main">
      <!-- Hero Section with Panel -->
      <header class="blogs-hero">
        <Panel variant="elevated" glow={true} class="hero-panel hero-panel-base">
          <h1 class="blogs-hero__title" data-bilingual>
            <span data-lang="en">Blogs</span>
            <span data-lang="id">Blog</span>
          </h1>
          <p class="blogs-hero__description" data-bilingual>
            <span data-lang="en">Thoughts on web development, design, and technology</span>
            <span data-lang="id">Pemikiran tentang pengembangan web, desain, dan teknologi</span>
          </p>
        </Panel>
      </header>
      
      <div class="blogs-content">
        <BlogList />
      </div>
    </main>
    
    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<style>
  .blogs-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }

  /* Hero Section - matches music page padding */
  .blogs-hero {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 0 calc(var(--space-32) / 3);
  }
  
  .blogs-hero__title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--leading-tight);
  }
  

  
  .blogs-hero__description {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  


  .blogs-content {
    padding-bottom: 0;
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .blogs-main {
      padding: var(--space-16) var(--space-4);
    }
    
    .blogs-hero {
      padding: 0 0 calc(var(--space-16) / 3);
    }
    
    .blogs-hero__title {
      font-size: var(--text-3xl);
    }
    
    .blogs-hero__description {
      font-size: var(--text-sm);
    }
    
    .blogs-content {
      padding-bottom: 0;
    }
  }
  

</style>
