---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import ListingHero from '../../components/ui/ListingHero.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import BlogList from '../../components/blogs/BlogList.astro';
import { homeConfig } from '../../config/home';

const currentPath = Astro.url.pathname;
---

<BaseLayout 
  title="Blog | Gerry Moeis"
  description="Thoughts on web development, design, and technology. Explore articles about modern web development, accessibility, and creative coding."
  ogImage="/images/blogs/ai-data-extraction-hero.webp"
  ogType="website"
>
  <SemiCylindricalNav links={homeConfig.navigation} currentPath={currentPath} />
  
  <div class="page-layout depth-mid blogs-page">
    <PageBackgroundGradient />
    <main role="main" class="blogs-main">
      <ListingHero
        title={{ en: 'Blogs', id: 'Blog' }}
        description={{ en: 'Thoughts on web development, design, and technology', id: 'Pemikiran tentang pengembangan web, desain, dan teknologi' }}
      />
      
      <div class="blogs-content">
        <BlogList />
      </div>
    </main>
    
    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<style>
  .blogs-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }

  .blogs-content {
    padding-bottom: 0;
  }
  
  @media (max-width: var(--breakpoint-lg)) {
    .blogs-main {
      padding: var(--space-16) var(--space-4);
    }
  }
</style>
