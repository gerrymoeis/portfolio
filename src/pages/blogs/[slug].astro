---
/**
 * Blog Detail Page - Dynamic route for individual blog posts
 * Renders blog post content with full metadata and SEO optimization
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import ViewCounter from '../../components/blogs/ViewCounter.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import OptimizedImage from '../../components/ui/OptimizedImage.astro';
import { homeConfig } from '../../config/home';

// Generate static paths for all blog posts at build time
export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs');
  
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the blog entry from props
const { entry } = Astro.props;

// Render the markdown content to HTML
const { Content } = await entry.render();

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Get current path for active state
const currentPath = Astro.url.pathname;

// Format date for display
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.date);
---

<BaseLayout
  title={`${entry.data.title.en} | Gerry Moeis`}
  description={entry.data.summary.en}
  ogType="article"
>
  <!-- Semi-Cylindrical Navigation (Fixed at top) -->
  <SemiCylindricalNav links={navLinks} currentPath={currentPath} />
  
  <div class="page-layout depth-mid">
    <PageBackgroundGradient />
    <main class="blog-detail" role="main">
      <article class="blog-article">
        <!-- Hero Image -->
        <figure class="blog-hero">
          <OptimizedImage 
            src={entry.data.heroImage}
            alt={`${entry.data.title.en} hero image`}
            width={1200}
            height={675}
            loading="eager"
            fetchpriority="high"
            class="blog-hero__image"
          />
        </figure>

        <header class="blog-header">
          <h1 class="blog-title" data-bilingual>
            <span data-lang="en">{entry.data.title.en}</span>
            <span data-lang="id">{entry.data.title.id}</span>
          </h1>
          
          <div class="blog-meta">
            <time datetime={entry.data.date.toISOString()} class="blog-date">
              {formattedDate}
            </time>
            
            <!-- View Counter -->
            <ViewCounter slug={entry.slug} />
            
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="blog-tags" role="list" aria-label="Article tags">
                {entry.data.tags.map(tag => (
                  <span class="blog-tag" role="listitem">{tag}</span>
                ))}
              </div>
            )}
          </div>
          
          <p class="blog-summary" data-bilingual>
            <span data-lang="en">{entry.data.summary.en}</span>
            <span data-lang="id">{entry.data.summary.id}</span>
          </p>
        </header>
        
        <div class="blog-content">
          <Content />
        </div>
      </article>
    </main>

    <Footer currentPath={currentPath} />
  </div>
  
</BaseLayout>

<style>
  .blog-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }
  
  .blog-article {
    padding: 0;
  }
  
  .blog-article article {
    animation: fadeIn var(--duration-medium) var(--ease-out);
  }
  
  .blog-hero {
    position: relative;
    margin: 0 0 var(--space-10);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .blog-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(to top, var(--bg-elevated) 0%, transparent 3%),
      linear-gradient(to right, var(--bg-elevated) 0%, transparent 1%),
      linear-gradient(to left, var(--bg-elevated) 0%, transparent 1%);
  }

  .blog-hero__image {
    width: 100%;
    display: block;
    mask-image: linear-gradient(to bottom, transparent 0%, black 2%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 2%);
  }

  :global([data-theme="light"]) .blog-hero::after {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(var(--space-4));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .blog-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-medium);
  }
  
  .blog-title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }
  

  
  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-6);
  }
  
  .blog-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }
  
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .blog-tag {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--bg-surface);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-accent);
  }
  
  .blog-summary {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    font-style: italic;
  }
  

  
  .blog-content {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-primary);
  }
  

  
  .blog-content :global(h1),
  .blog-content :global(h2),
  .blog-content :global(h3),
  .blog-content :global(h4),
  .blog-content :global(h5),
  .blog-content :global(h6) {
    font-family: var(--font-primary);
    font-weight: var(--weight-bold);
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  
  .blog-content :global(h1) {
    font-size: 2rem;
    margin-top: 3rem;
  }
  
  .blog-content :global(h2) {
    font-size: 1.625rem;
    margin-top: 2.5rem;
  }
  
  .blog-content :global(h3) {
    font-size: 1.375rem;
    margin-top: 2rem;
  }
  
  .blog-content :global(p) {
    margin-bottom: 1.25rem;
  }
  
  .blog-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-link);
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }
  
  .blog-content :global(a:hover) {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }
  
  .blog-content :global(ul) {
    list-style: disc;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
    line-height: 1.7;
  }
  
  .blog-content :global(ol) {
    list-style: decimal;
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
    line-height: 1.7;
  }
  
  .blog-content :global(li) {
    margin-bottom: 0.5rem;
  }
  
  .blog-content :global(li:last-child) {
    margin-bottom: 0;
  }
  
  .blog-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.875em;
    background: var(--bg-elevated);
    letter-spacing: 0;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    border: 1px solid var(--color-border-medium);
  }
  
  .blog-content :global(pre) {
    background: var(--bg-elevated);
    padding: 1.25rem;
    border-radius: 6px;
    border: 1px solid var(--color-border-medium);
    overflow-x: auto;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  
  .blog-content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }
  
  .blog-content :global(blockquote) {
    border-left: 3px solid var(--color-accent-primary);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
    font-style: italic;
    font-size: 1.0625rem;
  }
  
  .blog-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 2rem 0;
  }
  
  .blog-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-medium);
    margin: 2.5rem 0;
  }
  
  @media (max-width: 768px) {
    .blog-detail {
      padding: var(--space-16) var(--space-4);
    }
    
    .blog-article {
      padding: 0;
    }
    
    .blog-title {
      font-size: var(--text-3xl);
    }
    
    .blog-summary {
      font-size: var(--text-base);
    }
    
    .blog-content {
      font-size: 1rem;
    }
    
    .blog-content :global(h1) {
      font-size: 1.75rem;
    }
    
    .blog-content :global(h2) {
      font-size: 1.5rem;
    }
    
    .blog-content :global(h3) {
      font-size: 1.25rem;
    }
  }
  
  @media (max-width: 480px) {
    .blog-detail {
      padding: var(--space-16) var(--space-3);
    }
    
    .blog-article {
      padding: 0;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .blog-article {
      animation: none;
    }
  }
</style>
