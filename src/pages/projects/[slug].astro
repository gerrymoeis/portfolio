---
/**
 * Project Detail Page - Dynamic route for individual projects
 * Renders project content with parallax storytelling and full metadata
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import ParallaxLayer from '../../components/projects/ParallaxLayer.astro';
import Panel from '../../components/ui/Panel.astro';
import Icon from '../../components/ui/Icon.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import { Picture } from 'astro:assets';
import { homeConfig } from '../../config/home';

// Generate static paths for all projects at build time
export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  
  return projectEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the project entry from props
const { entry } = Astro.props;

// Render the markdown content to HTML
const { Content } = await entry.render();

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Get current path for active state
const currentPath = Astro.url.pathname;

// Format status for display
const statusDisplay = entry.data.status === 'in-progress' ? 'In Progress' : 
                      entry.data.status === 'completed' ? 'Completed' : 
                      'Archived';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="website"
  ogImage={entry.data.heroImage}
>
  <!-- Semi-Cylindrical Navigation (Fixed at top) -->
  <SemiCylindricalNav links={navLinks} currentPath={currentPath} />
  
  <div class="page-layout depth-mid">
    <PageBackgroundGradient />
    <main class="project-detail">
      <!-- Hero section with parallax background -->
      <section class="project-hero">
        <!-- Background layer - slowest movement -->
        <ParallaxLayer speed={0.3} class="hero-background" zIndex={1}>
          <div class="hero-gradient"></div>
        </ParallaxLayer>
        
        <!-- Visual layer - medium movement -->
        <ParallaxLayer speed={0.5} class="hero-visual" zIndex={2}>
          <div class="hero-image-container">
            <Picture 
              src={entry.data.heroImage} 
              alt={`${entry.data.title} hero image`}
              class="hero-image"
              width={1000}
              height={563}
              widths={[400, 800, 1000]}
              sizes="(max-width: 768px) 100vw, 1000px"
              formats={['webp', 'jpg']}
              loading="eager"
            />
          </div>
        </ParallaxLayer>
        
        <!-- Text layer - minimal movement for readability -->
        <ParallaxLayer speed={0.9} class="hero-content" zIndex={3}>
          <div class="hero-text">
            <h1 class="project-title">{entry.data.title}</h1>
            <div class="project-meta">
              <span class="project-year">{entry.data.year}</span>
              <span class="project-status" data-status={entry.data.status}>{statusDisplay}</span>
            </div>
            <p class="project-summary">{entry.data.summary}</p>
          </div>
        </ParallaxLayer>
      </section>
      
      <!-- Project info panel -->
      <section class="project-info-section">
        <Panel variant="elevated" class="project-info">
          <div class="info-grid">
            <div class="info-block">
              <h3 class="info-label">Tech Stack</h3>
              <ul class="tech-list">
                {entry.data.techStack.map(tech => (
                  <li class="tech-item">{tech}</li>
                ))}
              </ul>
            </div>
            
            {entry.data.links && (
              <div class="info-block">
                <h3 class="info-label">Links</h3>
                <div class="project-links">
                  {entry.data.links.github && (
                    <a href={entry.data.links.github} class="project-link" target="_blank" rel="noopener noreferrer">
                      <Icon name="github" size="sm" />
                      GitHub
                    </a>
                  )}
                  {entry.data.links.live && (
                    <a href={entry.data.links.live} class="project-link" target="_blank" rel="noopener noreferrer">
                      <Icon name="live" size="sm" />
                      Live Site
                    </a>
                  )}
                  {entry.data.links.demo && (
                    <a href={entry.data.links.demo} class="project-link" target="_blank" rel="noopener noreferrer">
                      <Icon name="demo" size="sm" />
                      Demo
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        </Panel>
      </section>
      
      <!-- Project content with parallax storytelling -->
      <article class="project-content">
        <ParallaxLayer speed={0.95} class="content-layer">
          <div class="content-wrapper">
            <Content />
          </div>
        </ParallaxLayer>
      </article>
    </main>

    <Footer currentPath={currentPath} />
  </div>
  
  <!-- Initialize parallax effects -->
  <script>
    import { initParallax } from '../../scripts/parallax';
    
    // Initialize parallax when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initParallax);
    } else {
      initParallax();
    }
  </script>
</BaseLayout>

<style>
  .page-layout {
    position: relative;
    min-height: 100vh;
    background: var(--bg-elevated);
  }
  
  .page-layout > :global(*:not(.page-gradient)) {
    position: relative;
    z-index: 1;
  }

  .project-detail {
    padding-top: 80px;
  }
  
  .project-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-6);
    min-height: 70vh;
  }
  
  .hero-background {
    position: absolute;
    inset: 0;
  }
  
  .hero-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-bg-mid) 0%,
      var(--color-bg-dark) 50%,
      var(--color-bg-deep) 100%
    );
  }
  
  .hero-visual {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    order: 1;
  }
  
  .hero-image-container {
    max-width: 100%;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
  }
  
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
  }
  
  .hero-content {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 800px;
    padding: var(--space-6);
    order: 2;
  }
  
  .hero-text {
    text-align: center;
  }
  
  .project-title {
    font-family: var(--font-primary);
    font-size: var(--text-5xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4) 0;
    line-height: var(--leading-tight);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }
  
  .project-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }
  
  .project-year {
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }
  
  .project-status {
    padding: var(--space-2) var(--space-4);
    border-radius: 4px;
    font-weight: var(--weight-medium);
    background: var(--color-surface-dark);
    border: 1px solid var(--color-border-medium);
    backdrop-filter: blur(4px);
  }
  
  .project-status[data-status="completed"] {
    color: #8bc34a;
    border-color: rgba(139, 195, 74, 0.3);
  }
  
  .project-status[data-status="in-progress"] {
    color: #ffc107;
    border-color: rgba(255, 193, 7, 0.3);
  }
  
  .project-status[data-status="archived"] {
    color: var(--color-text-tertiary);
  }
  
  .project-summary {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  
  .project-info-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }
  
  .project-info {
    backdrop-filter: blur(8px);
  }
  
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-8);
  }
  
  .info-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-4) 0;
  }
  
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .tech-item {
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-dark);
    border: 1px solid var(--color-border-medium);
    border-radius: 4px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }
  
  .project-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .project-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-primary);
    text-decoration: none;
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }
  
  .project-link:hover {
    color: var(--color-accent-secondary);
  }
  
  .project-link:focus {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }
  
  .project-content {
    position: relative;
    background: var(--color-bg-deep);
  }
  
  .content-layer {
    position: relative;
  }
  
  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }
  
  .content-wrapper :global(h1),
  .content-wrapper :global(h2),
  .content-wrapper :global(h3),
  .content-wrapper :global(h4),
  .content-wrapper :global(h5),
  .content-wrapper :global(h6) {
    font-family: var(--font-primary);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
  }
  
  .content-wrapper :global(h1) {
    font-size: var(--text-4xl);
  }
  
  .content-wrapper :global(h2) {
    font-size: var(--text-3xl);
  }
  
  .content-wrapper :global(h3) {
    font-size: var(--text-2xl);
  }
  
  .content-wrapper :global(p) {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }
  
  .content-wrapper :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-border-medium);
    text-underline-offset: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }
  
  .content-wrapper :global(a:hover) {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-hover);
  }
  
  .content-wrapper :global(ul),
  .content-wrapper :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-8);
  }
  
  .content-wrapper :global(li) {
    margin-bottom: var(--space-3);
    line-height: var(--leading-relaxed);
  }
  
  .content-wrapper :global(code) {
    font-family: var(--font-primary);
    font-size: 0.9em;
    background: var(--color-surface-base);
    letter-spacing: 0.02em;
    padding: var(--space-1) var(--space-2);
    border-radius: 3px;
    border: 1px solid var(--color-border-medium);
  }
  
  .content-wrapper :global(pre) {
    background: var(--color-surface-base);
    padding: var(--space-4);
    border-radius: 6px;
    border: 1px solid var(--color-border-medium);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }
  
  .content-wrapper :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }
  
  .content-wrapper :global(blockquote) {
    border-left: 3px solid var(--color-accent-primary);
    padding-left: var(--space-6);
    margin-left: 0;
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-style: italic;
  }
  
  .content-wrapper :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: var(--space-10) 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  
  .content-wrapper :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-medium);
    margin: var(--space-16) 0;
  }
  
  @media (min-width: 901px) {
    .project-hero {
      flex-direction: row;
      gap: var(--space-16);
      padding: var(--space-12) var(--space-8);
      min-height: 80vh;
    }
    
    .hero-visual {
      position: absolute;
      inset: 0;
      opacity: 0.3;
      order: unset;
    }
    
    .hero-image {
      filter: blur(3px) brightness(0.6);
    }
    
    .hero-content {
      position: relative;
      z-index: 3;
      order: unset;
    }
    
    .hero-text {
      text-align: center;
    }
  }
  
  @media (max-width: var(--breakpoint-lg)) {
    .project-detail {
      padding-top: 60px;
    }
    
    .project-title {
      font-size: var(--text-3xl);
    }
    
    .project-summary {
      font-size: var(--text-base);
    }
    
    .project-info-section {
      padding: var(--space-8) var(--space-4);
    }
    
    .info-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    
    .content-wrapper {
      padding: var(--space-12) var(--space-4);
    }
    
    .content-wrapper :global(h1) {
      font-size: var(--text-3xl);
    }
    
    .content-wrapper :global(h2) {
      font-size: var(--text-2xl);
    }
    
    .content-wrapper :global(p) {
      font-size: var(--text-base);
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .hero-visual {
      opacity: 0.15;
    }
  }
</style>
