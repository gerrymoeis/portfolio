---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import ListingHero from '../../components/ui/ListingHero.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import ProjectFilter from '../../components/projects/ProjectFilter.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { homeConfig } from '../../config/home';

const currentPath = Astro.url.pathname;
---

<BaseLayout 
  title="Projects | Gerry Moeis"
  description="Explore my portfolio of web development projects, featuring modern technologies, creative solutions, and innovative design approaches."
  ogImage="/images/projects/personal-portfolio-hero.webp"
  ogType="website"
>
  <SemiCylindricalNav links={homeConfig.navigation} currentPath={currentPath} />
  
  <div class="page-layout depth-mid projects-page">
    <PageBackgroundGradient />
    <main role="main" class="projects-main">
      <ListingHero
        title={{ en: 'Projects', id: 'Proyek' }}
        description={{ en: 'A collection of projects showcasing web development, design, and creative problem-solving.', id: 'Koleksi proyek yang menampilkan pengembangan web, desain, dan pemecahan masalah kreatif.' }}
      />
      
      <div class="projects-content">
        <ProjectFilter />
        <ProjectGrid />
      </div>
    </main>
    
    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<style>
  .projects-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }

  .projects-content {
    padding-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .projects-main {
      padding: var(--space-16) var(--space-4);
    }
  }
</style>
