---
/**
 * Projects Listing Page
 * 
 * Displays all projects in a grid layout with filtering by category.
 * Matches Blogs page hero styling for consistency.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import Panel from '../../components/ui/Panel.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import ProjectFilter from '../../components/projects/ProjectFilter.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { homeConfig } from '../../config/home';

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Get current path for active state
const currentPath = Astro.url.pathname;
---

<BaseLayout 
  title="Projects | Gerry Moeis"
  description="Explore my portfolio of web development projects, featuring modern technologies, creative solutions, and innovative design approaches."
  ogType="website"
>
  <!-- Semi-Cylindrical Navigation (Fixed at top) -->
  <SemiCylindricalNav links={navLinks} currentPath={currentPath} />
  
  <div class="page-layout depth-mid projects-page">
    <PageBackgroundGradient />
    <main role="main" class="projects-main">
      <!-- Hero Section with Panel (matches Blogs page) -->
      <header class="projects-hero">
        <Panel variant="elevated" glow={true} class="hero-panel">
          <h1 class="projects-hero__title" data-bilingual>
            <span data-lang="en">Projects</span>
            <span data-lang="id">Proyek</span>
          </h1>
          <p class="projects-hero__description" data-bilingual>
            <span data-lang="en">A collection of projects showcasing web development, design, and creative problem-solving.</span>
            <span data-lang="id">Koleksi proyek yang menampilkan pengembangan web, desain, dan pemecahan masalah kreatif.</span>
          </p>
        </Panel>
      </header>
      
      <div class="projects-content">
        <ProjectFilter />
        <ProjectGrid />
      </div>
    </main>
    
    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<style>
  .page-layout {
    position: relative;
    min-height: 100vh;
    padding-top: 100px;
    background: var(--bg-elevated);
  }
  
  .page-layout > :global(*:not(.page-gradient)) {
    position: relative;
    z-index: 1;
  }
  
  .projects-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Hero Section - Matches Blogs page styling */
  .projects-hero {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-12) 0 var(--space-8);
  }
  
  :global(.hero-panel) {
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }
  
  .projects-hero__title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--leading-tight);
  }
  
  /* Hide inactive language */
  .projects-hero__title span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .projects-hero__title span[data-lang="en"],
  :global(html[lang="id"]) .projects-hero__title span[data-lang="id"] {
    display: inline;
  }
  
  .projects-hero__description {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  
  /* Hide inactive language */
  .projects-hero__description span[data-lang] {
    display: none;
  }
  
  /* Show active language */
  :global(html[lang="en"]) .projects-hero__description span[data-lang="en"],
  :global(html[lang="id"]) .projects-hero__description span[data-lang="id"] {
    display: inline;
  }
  
  .projects-content {
    padding-bottom: var(--space-12);
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .page-layout {
      padding-top: 80px;
    }
    
    .projects-main {
      padding: 0 var(--space-4);
    }
    
    .projects-hero {
      padding: var(--space-8) 0 var(--space-6);
    }
    
    :global(.hero-panel) {
      padding: var(--space-6) var(--space-4);
    }
    
    .projects-hero__title {
      font-size: var(--text-3xl);
    }
    
    .projects-hero__description {
      font-size: var(--text-sm);
    }
    
    .projects-content {
      padding-bottom: var(--space-8);
    }
  }
  
  @media (max-width: 480px) {
    .projects-main {
      padding: 0 var(--space-3);
    }
    
    .projects-hero {
      padding: var(--space-6) 0 var(--space-4);
    }
    
    :global(.hero-panel) {
      padding: var(--space-4) var(--space-3);
    }
    
    .projects-hero__title {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-2);
    }
    
    .projects-hero__description {
      font-size: var(--text-xs);
    }
  }
</style>
