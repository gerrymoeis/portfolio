---
/**
 * Projects Listing Page
 * 
 * Displays all projects in a grid layout with filtering by category.
 * Matches Blogs page hero styling for consistency.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SemiCylindricalNav from '../../components/ui/SemiCylindricalNav.astro';
import Footer from '../../components/ui/Footer.astro';
import Panel from '../../components/ui/Panel.astro';
import PageBackgroundGradient from '../../components/ui/PageBackgroundGradient.astro';
import ProjectFilter from '../../components/projects/ProjectFilter.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { homeConfig } from '../../config/home';

// Get navigation links from config (single source of truth)
const navLinks = homeConfig.navigation;

// Get current path for active state
const currentPath = Astro.url.pathname;
---

<BaseLayout 
  title="Projects | Gerry Moeis"
  description="Explore my portfolio of web development projects, featuring modern technologies, creative solutions, and innovative design approaches."
  ogType="website"
>
  <!-- Semi-Cylindrical Navigation (Fixed at top) -->
  <SemiCylindricalNav links={navLinks} currentPath={currentPath} />
  
  <div class="page-layout depth-mid projects-page">
    <PageBackgroundGradient />
    <main role="main" class="projects-main">
      <!-- Hero Section with Panel (matches Blogs page) -->
      <header class="projects-hero">
        <Panel variant="elevated" glow={true} class="hero-panel">
          <h1 class="projects-hero__title" data-bilingual>
            <span data-lang="en">Projects</span>
            <span data-lang="id">Proyek</span>
          </h1>
          <p class="projects-hero__description" data-bilingual>
            <span data-lang="en">A collection of projects showcasing web development, design, and creative problem-solving.</span>
            <span data-lang="id">Koleksi proyek yang menampilkan pengembangan web, desain, dan pemecahan masalah kreatif.</span>
          </p>
        </Panel>
      </header>
      
      <div class="projects-content">
        <ProjectFilter />
        <ProjectGrid />
      </div>
    </main>
    
    <Footer currentPath={currentPath} />
  </div>
</BaseLayout>

<style>

  
  .projects-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-32) var(--space-6);
  }

  /* Hero Section - Matches music page padding */
  .projects-hero {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 0 calc(var(--space-32) / 3);
  }
  
  :global(.hero-panel) {
    padding: var(--space-8) var(--space-6);
    text-align: center;
  }
  
  .projects-hero__title {
    font-family: var(--font-primary);
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--leading-tight);
  }
  

  
  .projects-hero__description {
    font-family: var(--font-primary);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  

  
  .projects-content {
    padding-bottom: 0;
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .projects-main {
      padding: var(--space-16) var(--space-4);
    }
    
    .projects-hero {
      padding: 0 0 calc(var(--space-16) / 3);
    }
    
    :global(.hero-panel) {
      padding: var(--space-6) var(--space-4);
    }
    
    .projects-hero__title {
      font-size: var(--text-3xl);
    }
    
    .projects-hero__description {
      font-size: var(--text-sm);
    }
    
    .projects-content {
      padding-bottom: 0;
    }
  }
  

</style>
